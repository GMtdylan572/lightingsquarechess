---
/**
 * Registration happens in Google Forms, in another tab, behind a Google
 * sign-in, so the site cannot see the form being submitted. Instead: when
 * someone clicks a Register link and later comes back to this tab, ask
 * whether they finished, and set off fireworks if they did.
 */
---
<dialog
  id="reg-check"
  aria-labelledby="reg-check-title"
  class="m-auto w-[min(26rem,calc(100vw-2rem))] rounded-md border border-border bg-card p-6 text-foreground shadow-2xl backdrop:bg-black/40"
>
  <div data-step="ask">
    <p id="reg-check-title" class="text-[1.2rem] font-semibold">Did you finish registering?</p>
    <p class="mt-2 text-[0.95rem] text-muted-foreground">
      For <span data-event>your event</span>.
    </p>
    <div class="mt-5 flex flex-wrap gap-3">
      <button type="button" data-yes class="inline-flex h-11 items-center rounded-sm bg-primary px-5 font-medium text-primary-foreground transition-colors hover:bg-primary/90">
        Yes, I'm registered
      </button>
      <button type="button" data-no class="inline-flex h-11 items-center rounded-sm border border-input px-5 font-medium transition-colors hover:bg-accent">
        Not yet
      </button>
    </div>
  </div>

  <div data-step="done" hidden>
    <p class="text-[1.35rem] font-semibold">You're in! 🎉</p>
    <p class="mt-2 text-[0.95rem] text-muted-foreground">
      See you at the board for <span data-event>your event</span>. Pairings and
      updates go out in the WhatsApp group.
    </p>
    <button type="button" data-close class="mt-5 inline-flex h-11 items-center rounded-sm bg-primary px-5 font-medium text-primary-foreground transition-colors hover:bg-primary/90">
      Close
    </button>
  </div>
</dialog>

<script>
  import { fireworks } from "@/lib/fireworks";

  const KEY = "lsc-registering";
  const MIN_AWAY_MS = 10_000; // ignore quick tab flicks
  const dialog = document.getElementById("reg-check") as HTMLDialogElement | null;

  const isForm = (href: string) => /docs\.google\.com\/forms|forms\.gle/.test(href);

  const save = (v: { event: string; at: number } | null) => {
    try {
      v ? sessionStorage.setItem(KEY, JSON.stringify(v)) : sessionStorage.removeItem(KEY);
    } catch {}
  };
  const load = (): { event: string; at: number } | null => {
    try {
      return JSON.parse(sessionStorage.getItem(KEY) || "null");
    } catch {
      return null;
    }
  };

  let pending = load();

  document.addEventListener("click", (e) => {
    const a = (e.target as Element | null)?.closest?.("a[href]") as HTMLAnchorElement | null;
    if (!a || !isForm(a.href)) return;
    const label = a.dataset.register || a.closest("[data-event-name]")?.getAttribute("data-event-name") || "your event";
    pending = { event: label, at: Date.now() };
    save(pending);
  });

  const show = () => {
    if (!dialog || !pending || dialog.open) return;
    if (Date.now() - pending.at < MIN_AWAY_MS) return;
    dialog.querySelectorAll("[data-event]").forEach((el) => (el.textContent = pending!.event));
    (dialog.querySelector('[data-step="ask"]') as HTMLElement).hidden = false;
    (dialog.querySelector('[data-step="done"]') as HTMLElement).hidden = true;
    dialog.showModal();
  };

  document.addEventListener("visibilitychange", () => {
    if (document.visibilityState === "visible") show();
  });
  window.addEventListener("focus", show);

  dialog?.querySelector("[data-yes]")?.addEventListener("click", () => {
    (dialog.querySelector('[data-step="ask"]') as HTMLElement).hidden = true;
    (dialog.querySelector('[data-step="done"]') as HTMLElement).hidden = false;
    pending = null;
    save(null);
    fireworks();
  });
  dialog?.querySelector("[data-no]")?.addEventListener("click", () => {
    pending = null;
    save(null);
    dialog.close();
  });
  dialog?.querySelector("[data-close]")?.addEventListener("click", () => dialog.close());
</script>
