---
// Vanilla drawer. This used to be the shadcn <Sheet>, but hydrating React
// on all 18 pages cost ~210 KB just to open a menu. shadcn islands are kept
// for the FAQ accordion and the results table, where the interactivity is
// real. Everything here is a <dialog> plus 20 lines of script.
import { nav } from "@/data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<button
  type="button"
  id="drawer-open"
  aria-label="Open menu"
  aria-controls="drawer"
  aria-expanded="false"
  class="inline-flex h-9 w-9 items-center justify-center rounded-sm border border-border text-foreground transition-colors hover:bg-accent lg:hidden"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
</button>

<!-- <dialog> gives focus trapping, Escape-to-close and inertness for free. -->
<dialog
  id="drawer"
  aria-label="Site menu"
  class="m-0 ml-auto h-dvh max-h-none w-[88vw] max-w-sm bg-card p-0 text-foreground backdrop:bg-black/50 open:flex open:flex-col"
>
  <div class="flex items-center justify-between border-b border-border px-4 py-3">
    <span class="label">Menu</span>
    <button
      type="button"
      id="drawer-close"
      aria-label="Close menu"
      class="inline-flex h-9 w-9 items-center justify-center rounded-sm border border-border transition-colors hover:bg-accent"
    >
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto p-4" aria-label="Mobile">
    {
      nav.map((item) => (
        <div class="mb-1">
          <a
            href={item.href}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "block rounded-sm px-3 py-2.5 text-[1.02rem] font-medium",
              isActive(item.href) ? "bg-accent text-primary" : "hover:bg-accent",
            ]}
          >
            {item.label}
          </a>
          {item.children && (
            <div class="ml-3 border-l border-border pl-3">
              {item.children.slice(1).map((c) => (
                <a
                  href={c.href}
                  class="block rounded-sm px-3 py-2 text-[0.92rem] text-muted-foreground hover:bg-accent hover:text-foreground"
                >
                  {c.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))
    }
    <a
      href="/quads"
      class="mt-4 inline-flex h-11 w-full items-center justify-center rounded-sm bg-primary px-4 font-medium text-primary-foreground"
    >
      Play a quad
    </a>
  </nav>
</dialog>

<script>
  const dlg = document.getElementById("drawer") as HTMLDialogElement | null;
  const openBtn = document.getElementById("drawer-open");
  const closeBtn = document.getElementById("drawer-close");
  if (dlg && openBtn) {
    const sync = () => openBtn.setAttribute("aria-expanded", String(dlg.open));
    openBtn.addEventListener("click", () => {
      dlg.showModal();
      document.body.style.overflow = "hidden";
      sync();
    });
    const close = () => {
      dlg.close();
      sync();
    };
    closeBtn?.addEventListener("click", close);
    // Clicking the backdrop closes it; clicks inside the panel do not.
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) close();
    });
    dlg.addEventListener("close", () => {
      document.body.style.overflow = "";
      sync();
    });
  }
</script>
