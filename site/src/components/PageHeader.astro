---
import Bolt from "@/components/Bolt.astro";

interface Props {
  kicker?: string;
  title: string;
  lede?: string;
  crumbs?: { href: string; label: string }[];
}
const { kicker, title, lede, crumbs = [] } = Astro.props;
---
<section
  class="relative isolate overflow-hidden border-b border-border"
  style="background: linear-gradient(120deg, color-mix(in srgb, var(--sky) 10%, white) 0%, color-mix(in srgb, var(--sun) 10%, white) 55%, color-mix(in srgb, var(--spark) 9%, white) 100%);"
>
  <Bolt size={300} class="bolt-mark hidden sm:block" />
  <div class="mx-auto max-w-6xl px-5 py-14 sm:py-20">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-5 flex flex-wrap items-center gap-2 text-[0.8rem] text-muted-foreground">
        {crumbs.map((c) => (
          <>
            <a href={c.href} class="hover:text-primary hover:underline">{c.label}</a>
            <span aria-hidden="true">/</span>
          </>
        ))}
        <span class="font-medium text-foreground">{title}</span>
      </nav>
    )}
    {kicker && (
      <p class="bolt-rule label mb-4 max-w-md text-spark">
        <Bolt size={13} />
        {kicker}
      </p>
    )}
    <h1 class="max-w-4xl text-[2.5rem] text-navy sm:text-6xl">{title}</h1>
    {lede && <p class="mt-5 max-w-2xl text-[1.08rem] leading-relaxed text-muted-foreground">{lede}</p>}
    <slot />
  </div>
</section>
