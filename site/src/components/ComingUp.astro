---
/**
 * The next quad and the next championship, side by side. Sits at the top of
 * the home and tournaments pages so the nearest dates are the first thing
 * anyone sees.
 */
import Bolt from "@/components/Bolt.astro";
import { upcomingQuads, upcomingChampionships } from "@/data/site";

const quad = upcomingQuads[0];
const champ = upcomingChampionships.find((e) => new Date(e.date) >= new Date()) ?? upcomingChampionships[0];

const month = (iso: string) =>
  new Date(iso).toLocaleString("en-US", { month: "long", timeZone: "UTC" });
const day = (iso: string) => new Date(iso).getUTCDate();

const months = [...new Set([quad, champ].filter(Boolean).map((e) => month(e!.date)))];

const events = [
  quad && {
    kind: "Monthly quad",
    name: quad.name,
    date: quad.date,
    display: quad.display,
    detail: `${quad.venue.name} · ${quad.format} · USCF-rated`,
    tone: "var(--sky)",
    links: [
      quad.register && { href: quad.register, label: "Register", primary: true, ext: true },
      quad.entries && { href: quad.entries, label: "Live entries", ext: true },
      { href: "/quads", label: "Details" },
    ],
  },
  champ && {
    kind: "Championship",
    name: champ.name,
    date: champ.date,
    display: champ.display,
    detail: "Rated Swiss with prize money, then an evening blitz",
    tone: "var(--spark)",
    links: [
      { href: champ.swiss.register, label: "Register: Swiss", primary: true, ext: true },
      { href: champ.blitz.register, label: "Register: Blitz", ext: true },
      { href: "/championship", label: "Details" },
    ],
  },
].filter(Boolean) as {
  kind: string; name: string; date: string; display: string; detail: string; tone: string;
  links: ({ href: string; label: string; primary?: boolean; ext?: boolean } | undefined | "")[];
}[];
---
<section aria-labelledby="coming-up" class="border-b border-border bg-white">
  <div class="mx-auto max-w-6xl px-5 py-10">
    <h2 id="coming-up" class="mb-6 text-3xl text-navy sm:text-4xl">
      Coming up in <span class="hl">{months.join(" & ")}</span>
    </h2>
    <div class="grid gap-5 md:grid-cols-2">
      {events.map((e) => (
        <article class="lift flex gap-5 rounded-2xl border border-border bg-white p-5 sm:p-6">
          <time
            datetime={e.date}
            class="flex h-20 w-20 shrink-0 flex-col items-center justify-center rounded-xl text-white"
            style={`background: ${e.tone}`}
          >
            <span class="text-[0.7rem] font-semibold uppercase tracking-[0.12em]">{month(e.date).slice(0, 3)}</span>
            <span class="font-heading text-[2rem] font-bold leading-none">{day(e.date)}</span>
          </time>
          <div class="min-w-0 flex-1">
            <p class="label" style={`color: ${e.tone}`}>{e.kind}</p>
            <h3 class="mt-1 text-[1.35rem] text-navy">{e.name}</h3>
            <p class="mt-1 text-[0.88rem] text-muted-foreground">{e.display} &middot; {e.detail}</p>
            <div class="mt-4 flex flex-wrap items-center gap-2">
              {e.links.filter(Boolean).map((l: any) => (
                <a
                  href={l.href}
                  target={l.ext ? "_blank" : undefined}
                  rel={l.ext ? "noopener noreferrer" : undefined}
                  class:list={[
                    "inline-flex h-9 items-center gap-1.5 rounded-full px-4 text-[0.86rem] font-semibold transition-colors",
                    l.primary ? "text-white hover:opacity-90" : "border border-input text-primary hover:border-primary",
                  ]}
                  style={l.primary ? `background: ${e.tone}` : undefined}
                >
                  {l.primary && <Bolt size={12} />}
                  {l.label}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
