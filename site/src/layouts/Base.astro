---
import "@/styles/global.css";
import SiteNav from "@/components/SiteNav.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { org } from "@/data/site";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === org.name ? title : `${title} — ${org.short} Chess`;
const cloudflareAnalyticsToken = import.meta.env.PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: org.name,
  alternateName: "Lightning Square Chess",
  foundingDate: String(org.founded),
  foundingLocation: { "@type": "Place", name: org.foundedIn },
  email: org.email,
  logo: org.logo,
  sameAs: [org.facebook],
  description:
    "A youth-led nonprofit bridging geographic and economic disparities in chess education.",
  areaServed: [
    "San Francisco Bay Area",
    "United States",
    "Kenya",
    "Nigeria",
    "Malawi",
    "South Africa",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FBF9F4" />
    {/* Flag JS before first paint so reveal styles never hide content
        from visitors without it. */}
    <script is:inline>document.documentElement.classList.add("js")</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={org.logo} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={org.logo} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

    {cloudflareAnalyticsToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: cloudflareAnalyticsToken })}
      ></script>
    )}
  </head>

  <body class="min-h-dvh">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-sm focus:bg-primary focus:px-4 focus:py-2 focus:font-medium focus:text-primary-foreground"
    >
      Skip to content
    </a>

    <SiteNav />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />

    <script>
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      /* Scroll reveal. Anything marked .reveal or .pop fades up when it
         enters the viewport. Blocks inside ordinary page sections are
         tagged automatically, so every page gets the same motion. */
      document
        .querySelectorAll<HTMLElement>("main section:not([data-no-reveal]) > div > *")
        .forEach((el, i) => {
          if (!el.closest("[data-no-reveal]") && !el.classList.contains("pop")) {
            el.classList.add("reveal");
          }
        });

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
      );
      document.querySelectorAll(".reveal, .pop").forEach((el) => io.observe(el));

      /* Parallax: each [data-parallax="0.15"] drifts at that fraction of
         the scroll distance relative to the viewport centre. */
      const layers = [...document.querySelectorAll<HTMLElement>("[data-parallax]")];
      const header = document.querySelector<HTMLElement>("[data-site-header]");
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          header?.toggleAttribute("data-scrolled", window.scrollY > 8);
          if (!reduce) {
            const vh = window.innerHeight;
            for (const el of layers) {
              const r = el.parentElement!.getBoundingClientRect();
              const offset = r.top + r.height / 2 - vh / 2;
              el.style.setProperty("--py", `${(-offset * Number(el.dataset.parallax || 0.1)).toFixed(1)}px`);
            }
          }
          ticking = false;
        });
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      onScroll();
    </script>
  </body>
</html>
