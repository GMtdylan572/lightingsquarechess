---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { schools } from "@/data/site";

export function getStaticPaths() {
  return schools.map((school) => ({ params: { slug: school.slug }, props: { school } }));
}

const { school } = Astro.props;
---
<Base
  title={school.name}
  description={`${school.name} in ${school.location}, ${school.country} runs a chess club started with Lightning Square's Club Bootstrap Initiative. ${school.body[0].slice(0, 110)}`}
>
  <PageHeader
    kicker={`${school.location}, ${school.country}`}
    title={school.name}
    crumbs={[{ href: "/", label: "Home" }, { href: "/schools", label: "Partner schools" }]}
  >
    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-white/10 pt-6">
      <div>
        <dt class="label mb-1 text-board-foreground/50">Coach</dt>
        <dd class="text-[0.95rem] text-white">{school.coach}</dd>
      </div>
      <div>
        <dt class="label mb-1 text-board-foreground/50">Club opened</dt>
        <dd class="font-mono text-[0.95rem] text-white">{school.since}</dd>
      </div>
      <div>
        <dt class="label mb-1 text-board-foreground/50">Country</dt>
        <dd class="text-[0.95rem] text-white">{school.country}</dd>
      </div>
    </dl>
  </PageHeader>

  <section class="mx-auto max-w-3xl px-5 py-16">
    {school.body.map((p) => (
      <p class="mb-5 text-[1.02rem] leading-relaxed text-muted-foreground last:mb-0">{p}</p>
    ))}
  </section>

  {school.sections && school.sections.length > 0 && (
    <section class="border-y border-border bg-secondary">
      <div class="mx-auto max-w-3xl px-5 py-16">
        {school.sections.map((sec) => (
          <article class="mb-12 last:mb-0">
            <h2 class="mb-3 text-[1.5rem] font-semibold">{sec.name}</h2>
            <p class="mb-6 leading-relaxed text-muted-foreground">{sec.body}</p>
            <div class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
              {sec.quotes.map((q) => (
                <figure class="rule-top pt-4">
                  <blockquote class="text-[0.94rem] leading-relaxed">{q.text}</blockquote>
                  <figcaption class="mt-3 font-mono text-[0.72rem] uppercase tracking-wider text-muted-foreground">
                    {q.who}{q.role && <span class="text-muted-foreground/60"> &middot; {q.role}</span>}
                  </figcaption>
                </figure>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="label mb-6">Photographs &middot; {school.photos.length}</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {school.photos.map((src) => (
        <li>
          <img src={src} alt={`Students at ${school.name}`} loading="lazy" width="600" height="450"
               class="aspect-[4/3] w-full rounded-md border border-border object-cover" />
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="label mb-10">From the school</h2>
      <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
        {school.quotes.map((q) => (
          <figure class="rule-top pt-6">
            <blockquote class="text-[0.98rem] leading-relaxed">{q.text}</blockquote>
            <figcaption class="mt-4 font-mono text-[0.75rem] uppercase tracking-wider text-muted-foreground">
              {q.who}{q.role && <span class="text-muted-foreground/60"> &middot; {q.role}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-5 py-14">
      <div>
        <h2 class="text-xl font-semibold">About Club Bootstrap</h2>
        <p class="mt-2 max-w-[52ch] text-muted-foreground">
          The programme that started this club is not taking on new schools at
          the moment. For anything about an existing partner school, write to us.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/programs/international" class="inline-flex h-12 items-center rounded-sm border border-input px-5 font-medium transition-colors hover:bg-accent">How it worked</a>
        <a href="/contact" class="inline-flex h-12 items-center rounded-sm bg-primary px-6 font-medium text-primary-foreground transition-colors hover:bg-primary/90">Get in touch</a>
      </div>
    </div>
  </section>
</Base>
