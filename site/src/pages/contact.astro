---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Bolt from "@/components/Bolt.astro";
import { org, upcomingQuads } from "@/data/site";

const next = upcomingQuads[0];
---
<Base
  title="Contact"
  description="Get in touch with Lightning Square Chess Club about tournaments, classes, existing partner schools, or volunteering."
>
  <PageHeader
    kicker="Say hello"
    title="Contact"
    lede="One inbox, read by the students who run the club."
    crumbs={[{ href: "/", label: "Home" }]}
  />

  <section class="mx-auto max-w-5xl px-5 py-16">
    <a href={`mailto:${org.email}`}
       class="block rounded-md border border-border bg-card p-8 transition-colors hover:bg-accent">
      <p class="label mb-3">Email</p>
      <p class="break-all font-heading text-2xl font-semibold sm:text-3xl">{org.email}</p>
      <p class="mt-3 text-muted-foreground">Write to the students who run the club.</p>
    </a>

    <div class="mt-px grid gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-3">
      <div class="bg-card p-6">
        <h2 class="mb-2 text-[1.08rem] font-semibold">Tournaments and classes</h2>
        <p class="text-[0.92rem] leading-relaxed text-muted-foreground">
          Entry questions, ratings, results, or anything about a specific event.
          The <a href="/quads/faq" class="text-primary underline underline-offset-2">quad FAQ</a> answers most of them already.
        </p>
      </div>
      <div class="bg-card p-6">
        <h2 class="mb-2 text-[1.08rem] font-semibold">Partner schools</h2>
        <p class="text-[0.92rem] leading-relaxed text-muted-foreground">
          For anything to do with an existing partner school, write to{" "}
          <a href={`mailto:${org.email}`} class="break-all text-primary underline underline-offset-2">{org.email}</a>.
        </p>
      </div>
      <div class="bg-card p-6">
        <h2 class="mb-2 text-[1.08rem] font-semibold">Coach or volunteer</h2>
        <p class="text-[0.92rem] leading-relaxed text-muted-foreground">
          We need strong student players who want to teach, and adults who can
          help direct events.
        </p>
      </div>
    </div>

    {/* The thing we actually want from a visitor is an entry, so it is stated
        here rather than left implied. */}
    <div class="mt-10 rounded-md border-l-2 border-gold bg-secondary p-6">
      <p class="bolt-rule label mb-3 max-w-[14rem] text-foreground">
        <Bolt size={13} class="text-gold" />
        Before you write
      </p>
      <h2 class="mb-2 text-[1.2rem] font-semibold">The monthly quad is the main thing we run</h2>
      <p class="mb-5 max-w-[58ch] text-[0.94rem] leading-relaxed text-muted-foreground">
        Registration is open for {next.display}, and for every date after it this
        year. Join the WhatsApp group for reminders and results.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href={next.register} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-11 items-center gap-2 rounded-sm bg-primary px-5 text-[0.92rem] font-medium text-primary-foreground transition-colors hover:bg-primary/90">
          <Bolt size={14} />
          Register for {next.display.replace(", 2026", "")}
        </a>
        <a href={org.whatsapp} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">
          Join the WhatsApp group
        </a>
      </div>
    </div>

    <p class="mt-8 text-[0.92rem] text-muted-foreground">
      We also post announcements on <a href={org.facebook} target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">Facebook</a>{" "}
      and run occasional free events on our <a href={org.chessCom} target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">Chess.com club</a>.
    </p>
  </section>
</Base>
