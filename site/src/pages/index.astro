---
import Base from "@/layouts/Base.astro";
import Bolt from "@/components/Bolt.astro";
import { upcomingQuads, upcomingChampionships, testimonials, patrons, org } from "@/data/site";

const next = upcomingQuads[0];

/* The championship is the flagship event: twice the field, prize money and a
   blitz. The homepage used to be quads only, so it gets its own band. */
const nextChamp = upcomingChampionships[0];
const laterChamps = upcomingChampionships.slice(1);

/* Ordered by what the club actually runs today. Club Bootstrap is listed
   last and flagged as past work — it is not taking new schools. */
const programs = [
  {
    href: "/programs/bay-area",
    tag: "Fall 2026 · Enrolling now",
    title: "Bay Area classes and the monthly rated quads",
    body:
      "Classes meet Tuesdays, September 8 to November 17, at De Anza Learning Center. The ten-session course, for players from unrated to USCF 1000, costs $15 per class.",
    figure: "24",
    figureNote: "rated quads run since 2023",
    photo: "https://i.ibb.co/Fq5BmC0n/bayarea-1s.jpg",
    tone: "var(--sky)",
  },
  {
    href: "/programs/national",
    tag: "Past programme · Alaska, North Dakota, Idaho, Mississippi",
    title: "Free online classes in four states",
    body:
      "US Chess has more than 76,000 members. Alaska and North Dakota have fewer than 100 each. From 2024 to 2025, we taught free online courses in those states, Idaho and Mississippi.",
    figure: "8",
    figureNote: "courses taught, 2024–2025",
    photo: "https://i.ibb.co/d0j36SF9/25206877-7060296.jpg",
    tone: "var(--mint)",
  },
  {
    href: "/programs/international",
    tag: "Past programme · Not taking new schools",
    title: "Club Bootstrap, 2025",
    body:
      "In 2025 we helped eight public schools across four countries start chess clubs with donated sets, online lessons and local support. We are not starting new partnerships at the moment.",
    figure: "8",
    figureNote: "public schools, four countries",
    photo: "https://i.ibb.co/BVX6f9ys/2c20fafa-4eec-46bd-9870-b171db690b8f.jpg",
    tone: "var(--berry)",
  },
];
/* Each schedule card gets its own light, cycling through the palette. */
const tones = ["var(--sky)", "var(--spark)", "var(--mint)", "var(--berry)"];

const stats = [
  { n: String(org.founded), note: `Founded in ${org.foundedIn}` },
  { n: "24", note: "Rated quads since 2023" },
  { n: "4", note: "States taught for free" },
  { n: "8", note: "Schools in four countries" },
];

/* Charlotte-style "where do you want to go" list, all existing pages. */
const quickLinks = [
  { href: next.register, label: `Register for the ${next.display.replace(", 2026", "")} quad`, ext: true },
  { href: "/championship", label: `Enter the ${nextChamp.name}` },
  { href: "/programs/bay-area", label: "Explore Bay Area classes" },
  { href: "/quads", label: "How the monthly quads work" },
];
---

<Base
  title={org.name}
  description="A youth-led nonprofit founded in San Jose that runs monthly USCF-rated quads, seasonal championships and Bay Area chess classes, with past free programs in four states and four countries."
>
  {/* Announcement bar for the flagship event. */}
  <a href="/championship" class="block bg-spark px-5 py-2.5 text-center text-[0.9rem] text-white transition-colors hover:bg-[#CC4823]">
    <span class="font-semibold">Championship:</span> Entries are also open for the {nextChamp.name},
    {" "}{nextChamp.display.replace(", 2026", "")}. <span class="font-semibold underline underline-offset-4">Explore now</span>
  </a>

  {/* Hero: the photo collage full bleed, shaded only behind the copy so the people stay visible. */}
  <section class="relative isolate overflow-hidden">
    <img
      src="/home-hero-collage-hq.jpg"
      alt="Lightning Square students coaching classes, playing chess and running tournaments"
      width="3584"
      height="2560"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#14213D]/85 from-10% via-[#14213D]/45 via-50% to-transparent to-80%" aria-hidden="true"></div>

    <div class="mx-auto max-w-6xl px-5 py-16 sm:py-28 [text-shadow:0_1px_12px_rgb(0_0_0/0.45)]">
      <div class="max-w-2xl">
        <p class="bolt-rule label mb-5 max-w-sm text-sun">
          <Bolt size={13} />
          Founded {org.founded} in {org.foundedIn}
        </p>
        <h1 class="max-w-[16ch] text-[2.6rem] text-white sm:text-6xl lg:text-[4.2rem]">
          A chess club run by the <span class="text-sun">students</span> it teaches.
        </h1>
        <p class="mt-6 max-w-[56ch] text-[1.05rem] leading-relaxed text-white">
          <strong class="font-semibold text-white">Our Mission:</strong>{" "}
          We are a student-led nonprofit organization dedicated to broadening access to chess across
          communities and backgrounds while empowering young people to learn, play, teach, and lead. We are
          committed to expanding opportunities for underrepresented players to participate, belong, and thrive in chess.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href={next.register} target="_blank" rel="noopener noreferrer" class="pill pill-spark">
            <Bolt size={15} />
            Register: {next.display.replace(", 2026", "")}
          </a>
          <a href={next.entries} target="_blank" rel="noopener noreferrer" class="pill pill-glass">Live entries</a>
          <a href="/quads/faq" class="pill px-3 text-white/85 hover:text-white">
            <span class="strike">Quad FAQ</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Quick links, Charlotte-style: where do you want to start. */}
  <nav aria-label="Get started" class="border-b border-border bg-white">
    <ul class="mx-auto grid max-w-6xl divide-y divide-border px-5 sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4">
      {quickLinks.map((l) => (
        <li>
          <a
            href={l.href}
            target={l.ext ? "_blank" : undefined}
            rel={l.ext ? "noopener noreferrer" : undefined}
            class="group flex items-center justify-between gap-3 py-5 text-[0.95rem] font-semibold text-navy transition-colors hover:text-spark sm:px-4"
          >
            {l.label}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-spark transition-transform group-hover:translate-x-1"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {/* Stats strip, as on a club's "trusted by" row. */}
  <section class="border-b border-border">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-5 py-12 lg:grid-cols-12">
      <h2 class="text-3xl text-navy lg:col-span-3">Run by students <span class="hl">since {org.founded}</span></h2>
      <dl class="grid grid-cols-2 gap-6 sm:grid-cols-4 lg:col-span-9">
        {stats.map((st, i) => (
          <div class="text-center">
            <dt class="sr-only">{st.note}</dt>
            <dd>
              <span class="stat-figure block font-heading text-4xl font-bold tracking-[-0.03em] sm:text-5xl" style={`color: ${tones[i]}`}>{st.n}</span>
              <span class="mt-1 block text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-muted-foreground">{st.note}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* Schedule. */}
  <section aria-labelledby="sched" class="bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="bolt-rule label mb-3 max-w-xs text-spark"><Bolt size={13} /> Registration open</p>
          <h2 id="sched" class="text-4xl text-navy sm:text-[2.75rem]">2026 Quad <span class="hl">Schedule</span></h2>
        </div>
        <a href="/quads" class="pill pill-outline h-11 px-5 text-[0.9rem]">Format and details &rarr;</a>
      </div>
      <ol class:list={["grid gap-5", upcomingQuads.length === 1 ? "max-w-md" : "sm:grid-cols-2", upcomingQuads.length % 3 === 0 ? "lg:grid-cols-3" : upcomingQuads.length > 1 && "lg:grid-cols-4"]}>
        {upcomingQuads.map((q, i) => (
          <li class="lift flex flex-col overflow-hidden rounded-2xl border border-border bg-white" >
            <span class="h-1.5" style={`background: ${tones[i % 4]}`} aria-hidden="true"></span>
            <div class="flex flex-1 flex-col p-6">
              <div class="flex items-start justify-between gap-3">
                <time datetime={q.date} class="font-heading text-[1.6rem] font-bold leading-tight tracking-[-0.02em] text-navy">
                  {q.display.replace(", 2026", "")}
                </time>
                {i === 0 && <span class="chip bg-spark text-white">Next</span>}
              </div>
              <p class="mt-2 text-[0.88rem] text-muted-foreground">
                {q.venue.name} &middot; {q.format}
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-border pt-4">
                <a href={q.register} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[0.9rem] font-semibold hover:underline" style={`color: ${tones[i % 4]}`}>
                  <Bolt size={12} /> Register
                </a>
                <a href={q.entries} target="_blank" rel="noopener noreferrer" class="text-[0.88rem] text-muted-foreground hover:text-primary hover:underline">Live entries</a>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* The flagship event, in championship gold. */}
  <section aria-labelledby="champ" class="mx-auto max-w-6xl px-5 py-20">
    <div class="tint grid overflow-hidden rounded-3xl border border-gold/40 lg:grid-cols-12" style="--tint: var(--sun)">
      <div class="p-7 sm:p-10 lg:col-span-7">
        <p class="bolt-rule label mb-4 max-w-[15rem] text-spark"><Bolt size={13} /> The flagship event</p>
        <h2 id="champ" class="text-4xl text-navy sm:text-5xl">{nextChamp.name}</h2>
        <p class="mt-3 text-[1.1rem] font-semibold text-spark">{nextChamp.display}</p>
        <p class="mt-5 max-w-[54ch] leading-relaxed text-muted-foreground">
          Our seasonal championship is a bigger day than a quad: a rated Swiss
          main tournament with prize money, then an evening blitz. Enter one
          or both. Sections and the venue are confirmed closer to the date.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={nextChamp.swiss.register} target="_blank" rel="noopener noreferrer" class="pill bg-gold text-gold-foreground hover:bg-[#E3A600]">
            <Bolt size={15} /> Register: Swiss
          </a>
          <a href={nextChamp.blitz.register} target="_blank" rel="noopener noreferrer" class="pill pill-outline">Register: Blitz</a>
          <a href="/championship" class="pill px-3 text-primary hover:underline">All championship dates &rarr;</a>
        </div>

        <div class="mt-10 border-t border-gold/40 pt-6">
          <p class="label mb-3">Championship calendar</p>
          <ol class="grid gap-2 sm:grid-cols-2">
            <li class="flex items-center justify-between gap-3 rounded-xl bg-white px-4 py-3 ring-2 ring-gold">
              <span class="font-semibold text-navy">{nextChamp.season} {new Date(nextChamp.date).getUTCFullYear()}</span>
              <time datetime={nextChamp.date} class="text-[0.85rem] font-medium text-spark">{nextChamp.display}</time>
            </li>
            {laterChamps.map((e) => (
              <li class="flex items-center justify-between gap-3 rounded-xl bg-white/70 px-4 py-3 ring-1 ring-border">
                <span class="text-foreground">{e.season} {new Date(e.date).getUTCFullYear()}</span>
                <time datetime={e.date} class="text-[0.85rem] text-muted-foreground">{e.display}</time>
              </li>
            ))}
          </ol>
          <a href="/championship/past" class="mt-5 inline-flex text-[0.92rem] font-semibold text-primary hover:underline">
            Results from the 2026 championship &rarr;
          </a>
        </div>
      </div>
      <div class="relative min-h-72 lg:col-span-5">
        <img
          src="/championship-2026-directors.jpeg"
          alt="Student directors running pairings at the 2026 Lightning Square championship"
          loading="lazy"
          class="absolute inset-0 h-full w-full object-cover object-[50%_75%]"
        />
      </div>
    </div>
  </section>

  {/* Programmes, as alternating photo and text rows. */}
  <section class="border-t border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
      <div class="mb-14 text-center">
        <p class="label mb-3">What we run</p>
        <h2 class="mx-auto max-w-3xl text-4xl text-navy sm:text-5xl">
          The tournaments come first. <span class="hl">The teaching feeds them.</span>
        </h2>
      </div>

      <div class="space-y-8">
        {programs.map((p, i) => (
          <article class="grid overflow-hidden rounded-3xl border border-border bg-white lg:grid-cols-2">
            <div class:list={["relative min-h-64", i % 2 === 1 && "lg:order-2"]}>
              <img src={p.photo} alt="" loading="lazy" width="640" height="480" class="absolute inset-0 h-full w-full object-cover" />
            </div>
            <div class="flex flex-col p-7 sm:p-10">
              <span class="chip tint self-start" style={`--tint: ${p.tone}; color: ${p.tone}`}>{p.tag}</span>
              <h3 class="mt-4 text-[1.75rem] text-navy">{p.title}</h3>
              <p class="mt-3 max-w-[58ch] leading-relaxed text-muted-foreground">{p.body}</p>
              <div class="mt-6 flex items-baseline gap-3 border-t border-border pt-5">
                <span class="stat-figure font-heading text-4xl font-bold" style={`color: ${p.tone}`}>{p.figure}</span>
                <span class="text-[0.88rem] text-muted-foreground">{p.figureNote}</span>
              </div>
              <a href={p.href} class="group mt-6 inline-flex items-center gap-2 self-start font-semibold text-primary">
                How it works
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-white transition-transform group-hover:translate-x-1">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* Origin. */}
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label mb-3">Who runs it</p>
        <h2 class="text-4xl text-navy">Led by <span class="hl">students</span>, from day one.</h2>
      </div>
      <div class="lg:col-span-8">
        <p class="max-w-[46ch] font-heading text-[1.5rem] font-semibold leading-snug tracking-[-0.02em] text-navy sm:text-[1.8rem]">
          Three high school chess players founded Lightning Square in San Jose
          in 2022: WCM Kally Wen, Wentao&nbsp;(Sean)&nbsp;Wu and Vincent&nbsp;Qin.
        </p>
        <p class="mt-6 max-w-[62ch] leading-relaxed text-muted-foreground">
          They were high school students at the time, and the club is still run
          by high school students. The tournament directors are students. The
          coaches are students. That student-led model keeps the club focused on
          creating practical ways for young players to learn and compete.
        </p>
        <a href="/about" class="pill pill-outline mt-7">The people involved &rarr;</a>
      </div>
    </div>
  </section>

  {/* Testimonials. */}
  <section class="border-t border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
      <div class="mb-12 text-center">
        <h2 class="text-4xl text-navy sm:text-5xl">What parents and directors <span class="hl">say</span></h2>
      </div>
      <div class="columns-1 gap-5 md:columns-2 lg:columns-3">
        {testimonials.map((t, i) => (
          <figure class="mb-5 break-inside-avoid rounded-2xl border border-border bg-white p-6">
            <div class="flex gap-0.5" style={`color: ${tones[i % 4]}`} aria-hidden="true">
              {[0, 1, 2, 3, 4].map(() => <Bolt size={14} />)}
            </div>
            <blockquote class="mt-4 text-[0.98rem] leading-relaxed text-foreground">{t.text}</blockquote>
            <figcaption class="mt-5 flex items-center gap-3 border-t border-border pt-4">
              <span class="flex h-9 w-9 items-center justify-center rounded-full text-[0.9rem] font-bold text-white" style={`background: ${tones[i % 4]}`} aria-hidden="true">
                {t.who.charAt(0)}
              </span>
              <span>
                <span class="block text-[0.92rem] font-semibold text-navy">{t.who}</span>
                {t.role && <span class="block text-[0.78rem] text-muted-foreground">{t.role}</span>}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* Patrons. */}
  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 text-center">
      <p class="label">Lightning Square Chess Club thanks its generous patrons</p>
      <ul class="flex flex-wrap items-center gap-10">
        {patrons.map((pt) => (
          <li>
            <img src={pt.logo} alt={pt.name ? `${pt.name} logo` : "Patron logo"} width="150" height="107" loading="lazy" class="h-14 w-auto" />
            {pt.name && <p class="mt-2 text-[0.82rem] text-muted-foreground">{pt.name}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Closing CTA. */}
  <section class="mx-auto max-w-6xl px-5">
    <div class="relative isolate overflow-hidden rounded-3xl px-7 py-14 text-white sm:px-12" style="background: linear-gradient(115deg, #1E3A8A 0%, #2F6FEB 100%);">
      <div class="board-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <Bolt size={340} class="absolute -right-10 -top-8 -z-10 rotate-12 text-sun/25" />
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <p class="bolt-rule label mb-3 max-w-[14rem] text-sun"><Bolt size={13} /> Play with us</p>
          <h2 class="text-3xl text-white sm:text-5xl">Come to a quad. Three rated games, one morning.</h2>
          <p class="mt-4 max-w-[50ch] leading-relaxed text-white/85">
            Every quad date through November is open for entry, and so is the
            {" "}{nextChamp.name} on {nextChamp.display.replace(", 2026", "")}. Join the
            WhatsApp group and you will hear about pairings, results and new
            events first.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
          <a href={next.register} target="_blank" rel="noopener noreferrer" class="pill pill-spark">
            <Bolt size={15} /> Register for the next quad
          </a>
          <a href="/championship" class="pill pill-white">Enter the championship</a>
          <a href={org.whatsapp} target="_blank" rel="noopener noreferrer" class="pill pill-glass">Join the WhatsApp group</a>
        </div>
      </div>
    </div>
  </section>
</Base>
