---
import Base from "@/layouts/Base.astro";
import Bolt from "@/components/Bolt.astro";
import { upcomingQuads, upcomingChampionships, testimonials, patrons, org } from "@/data/site";

const next = upcomingQuads[0];

/* The championship is the flagship event: twice the field, prize money and a
   blitz. The homepage used to be quads only, so it gets its own band. */
const nextChamp = upcomingChampionships[0];
const laterChamps = upcomingChampionships.slice(1);

/* Ordered by what the club actually runs today. Club Bootstrap is listed
   last and flagged as past work — it is not taking new schools. */
const programs = [
  {
    href: "/programs/bay-area",
    tag: "Fall 2026 · Enrolling now",
    title: "Bay Area classes and the monthly rated quads",
    body:
      "Classes meet Tuesdays, September 8 to November 17, at De Anza Learning Center. The ten-session course, for players rated around USCF 600, costs $15 per class.",
    figure: "24",
    figureNote: "rated quads run since 2023",
    photo: "https://i.ibb.co/Fq5BmC0n/bayarea-1s.jpg",
  },
  {
    href: "/programs/national",
    tag: "Past programme · Alaska, North Dakota, Idaho, Mississippi",
    title: "Free online classes in four states",
    body:
      "US Chess has more than 76,000 members. Alaska and North Dakota have fewer than 100 each. From 2024 to 2025, we taught free online courses in those states, Idaho and Mississippi.",
    figure: "8",
    figureNote: "courses taught, 2024–2025",
    photo: "https://i.ibb.co/d0j36SF9/25206877-7060296.jpg",
  },
  {
    href: "/programs/international",
    tag: "Past programme · Not taking new schools",
    title: "Club Bootstrap, 2025",
    body:
      "In 2025 we helped eight public schools across four countries start chess clubs with donated sets, online lessons and local support. We are not starting new partnerships at the moment.",
    figure: "8",
    figureNote: "public schools, four countries",
    photo: "https://i.ibb.co/BVX6f9ys/2c20fafa-4eec-46bd-9870-b171db690b8f.jpg",
  },
];
---

<Base
  title={org.name}
  description="A youth-led nonprofit founded in San Jose that runs monthly USCF-rated quads, seasonal championships and Bay Area chess classes, with past free programs in four states and four countries."
>
  {/* Clean split hero: copy and photograph stay separate so neither competes. */}
  <section class="border-b border-border bg-background text-[#111814]">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 py-12 sm:py-16 lg:grid-cols-[minmax(0,.82fr)_minmax(0,1.18fr)] lg:gap-14 lg:py-20">
      <div class="max-w-xl">
        <p class="bolt-rule label mb-5 max-w-sm text-primary">
          <Bolt size={13} />
          Founded {org.founded} in {org.foundedIn}
        </p>
        <h1
          class="max-w-[18ch] text-[2.6rem] font-semibold leading-[1.04] text-[#111814] sm:text-6xl lg:text-[4.1rem]"
        >
          A chess club run by the students it teaches.
        </h1>
        <p class="mt-6 max-w-[54ch] text-[1.06rem] leading-relaxed text-[#4d5b53]">
          <strong class="font-semibold text-[#243b30]">Our Mission:</strong>{" "}
          We are a student-led nonprofit organization dedicated to broadening access to chess across
          communities and backgrounds while empowering young people to learn, play, teach, and lead. We are
          committed to expanding opportunities for underrepresented players to participate, belong, and thrive in chess.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a
            href={next.register}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 items-center gap-2 rounded-sm bg-primary px-6 font-medium text-primary-foreground transition-colors hover:bg-primary/90"
          >
            <Bolt size={15} />
            Register: {next.display.replace(", 2026", "")}
          </a>
          <a
            href={next.entries}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 items-center rounded-sm border border-[#bdc6c0] px-6 font-medium text-[#173729] transition-colors hover:border-[#173729] hover:bg-[#f1f5f2]"
          >
            Live entries
          </a>
          <a
            href="/quads/faq"
            class="inline-flex h-12 items-center rounded-sm px-2 font-medium text-[#526159] transition-colors hover:text-[#173729]"
          >
            <span class="strike">Quad FAQ</span>
          </a>
        </div>

        <p class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.94rem] text-[#4d5b53]">
          <span class="rounded-sm bg-gold px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-gold-foreground">
            Championship
          </span>
          Entries are also open for the {nextChamp.name},
          <a href="/championship" class="font-medium text-[#173729] underline underline-offset-4 hover:text-primary">
            {nextChamp.display.replace(", 2026", "")}
          </a>
        </p>
      </div>

      <figure class="overflow-hidden rounded-md border border-border bg-card p-2 shadow-sm sm:p-3">
      <img
        src="/home-hero-collage-hq.jpg"
        alt="Lightning Square students coaching classes, playing chess and running tournaments"
        width="3584"
        height="2560"
        fetchpriority="high"
        class="h-auto w-full rounded-sm object-contain"
      />
      </figure>
    </div>
  </section>

  {/* Schedule strip, set like a fixtures list rather than a marketing banner. */}
  <section aria-labelledby="sched" class="border-b border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-8">
      <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="sched" class="label">2026 quad schedule &middot; registration open</h2>
        <a href="/quads" class="text-[0.88rem] font-medium text-primary hover:underline">
          Format and details
        </a>
      </div>
      <ol class="grid gap-px overflow-hidden rounded-md bg-border sm:grid-cols-2 lg:grid-cols-4">
        {
          upcomingQuads.map((q, i) => (
            <li class="flex flex-col bg-card p-4">
              <div class="flex items-baseline justify-between gap-3">
                <time datetime={q.date} class="font-mono text-[0.95rem] font-medium">
                  {q.display.replace(", 2026", "")}
                </time>
                {i === 0 && (
                  <span class="rounded-sm bg-primary px-1.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-primary-foreground">
                    Next
                  </span>
                )}
              </div>
              <p class="mt-1 text-[0.82rem] text-muted-foreground">
                {q.venue.name} &middot; {q.format}
              </p>
              <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 pt-3 [border-top:1px_solid_var(--rule)]">
                <a
                  href={q.register}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-[0.84rem] font-medium text-primary hover:underline"
                >
                  <Bolt size={11} />
                  Register
                </a>
                <a
                  href={q.entries}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[0.84rem] text-muted-foreground underline-offset-4 hover:text-foreground hover:underline"
                >
                  Live entries
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* The flagship event. Gold is the championship accent everywhere on the
      site, so the band leans on it rather than inventing a new treatment. */}
  <section aria-labelledby="champ" class="border-b border-border bg-background">
    <div class="mx-auto max-w-6xl px-5 py-14 sm:py-16">
      <div class="grid gap-10 rounded-md border border-border bg-card p-6 shadow-sm sm:p-8 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <p class="bolt-rule label mb-4 max-w-[15rem] text-primary">
            <Bolt size={13} />
            The flagship event
          </p>
          <h2 id="champ" class="text-3xl font-semibold sm:text-[2.5rem]">
            {nextChamp.name}
          </h2>
          <p class="mt-3 font-mono text-[1.05rem] text-muted-foreground">{nextChamp.display}</p>
          <p class="mt-5 max-w-[54ch] leading-relaxed text-muted-foreground">
            Our seasonal championship is a bigger day than a quad: a rated Swiss
            main tournament with prize money, then an evening blitz. Enter one
            or both. Sections and the venue are confirmed closer to the date.
          </p>

          <div class="mt-7 flex flex-wrap gap-3">
            <a
              href={nextChamp.swiss.register}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-12 items-center gap-2 rounded-sm bg-gold px-6 font-medium text-gold-foreground transition-colors hover:bg-gold/90"
            >
              <Bolt size={15} />
              Register: Swiss
            </a>
            <a
              href={nextChamp.blitz.register}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex h-12 items-center rounded-sm border border-input px-6 font-medium transition-colors hover:bg-accent"
            >
              Register: Blitz
            </a>
            <a
              href="/championship"
              class="inline-flex h-12 items-center gap-1.5 rounded-sm px-2 font-medium text-primary transition-colors hover:underline"
            >
              All championship dates
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 lg:border-l lg:border-border lg:pl-10">
          <p class="label mb-4">Championship calendar</p>
          <ol class="divide-y divide-border">
            <li class="flex items-baseline justify-between gap-3 pb-3">
              <span class="font-medium">{nextChamp.season} {new Date(nextChamp.date).getUTCFullYear()}</span>
              <span class="flex items-center gap-2">
                <time datetime={nextChamp.date} class="font-mono text-[0.88rem] text-muted-foreground">
                  {nextChamp.display}
                </time>
                <span class="rounded-sm bg-primary px-1.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider text-primary-foreground">
                  Next
                </span>
              </span>
            </li>
            {laterChamps.map((e) => (
              <li class="flex items-baseline justify-between gap-3 py-3">
                <span class="text-muted-foreground">{e.season} {new Date(e.date).getUTCFullYear()}</span>
                <time datetime={e.date} class="font-mono text-[0.88rem] text-muted-foreground">
                  {e.display}
                </time>
              </li>
            ))}
          </ol>
          <a href="/championship/past" class="mt-5 inline-flex items-center gap-1.5 text-[0.9rem] font-medium text-primary hover:underline">
            Results from the 2026 championship
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Programmes. Asymmetric editorial rows, not a three-card grid. */}
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
    <div class="mb-12 max-w-2xl">
      <p class="label mb-3">What we run</p>
      <h2 class="text-3xl font-semibold sm:text-[2.6rem]">
        The tournaments come first. The teaching feeds them.
      </h2>
    </div>

    <div class="divide-y divide-border">
      {
        programs.map((p) => (
          <article class="grid gap-8 py-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-4">
              <img
                src={p.photo}
                alt=""
                loading="lazy"
                width="640"
                height="480"
                class="aspect-[4/3] w-full rounded-md border border-border object-cover"
              />
            </div>
            <div class="lg:col-span-6">
              <p class="label mb-2">{p.tag}</p>
              <h3 class="mb-3 text-[1.45rem] font-semibold">{p.title}</h3>
              <p class="max-w-[58ch] leading-relaxed text-muted-foreground">{p.body}</p>
              <a
                href={p.href}
                class="mt-5 inline-flex items-center gap-1.5 text-[0.92rem] font-medium text-primary hover:underline"
              >
                How it works
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
            <div class="lg:col-span-2 lg:border-l lg:border-border lg:pl-6">
              <p class="stat-figure font-heading text-4xl font-semibold text-primary">{p.figure}</p>
              <p class="mt-1 text-[0.82rem] leading-snug text-muted-foreground">{p.figureNote}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* Origin. Text-led, no hero image, breaks the page rhythm on purpose. */}
  <section class="border-y border-border bg-secondary">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label">Who runs it</p>
      </div>
      <div class="lg:col-span-8">
        <p class="max-w-[46ch] font-heading text-[1.6rem] leading-snug sm:text-[1.9rem]">
          Three high school chess players founded Lightning Square in San Jose
          in 2022: WCM Kally Wen, Wentao&nbsp;(Sean)&nbsp;Wu and Vincent&nbsp;Qin.
        </p>
        <p class="mt-6 max-w-[62ch] leading-relaxed text-muted-foreground">
          They were high school students at the time, and the club is still run
          by high school students. The tournament directors are students. The
          coaches are students. That student-led model keeps the club focused on
          creating practical ways for young players to learn and compete.
        </p>
        <a
          href="/about"
          class="mt-6 inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent"
        >
          The people involved
        </a>
      </div>
    </div>
  </section>

  {/* Testimonials as a quiet quote list rather than a card carousel. */}
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
    <p class="label mb-10">What parents and directors say</p>
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        testimonials.map((t) => (
          <figure class="rule-top pt-6">
            <blockquote class="text-[0.98rem] leading-relaxed">{t.text}</blockquote>
            <figcaption class="mt-4 font-mono text-[0.75rem] uppercase tracking-wider text-muted-foreground">
              {t.who}
              {t.role && <span class="text-muted-foreground/60"> &middot; {t.role}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/* Patrons, acknowledged on the old site and kept here. */}
  <section class="border-t border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-12">
      <p class="label mb-6">Lightning Square Chess Club thanks its generous patrons</p>
      <ul class="flex flex-wrap items-center gap-10">
        {patrons.map((pt) => (
          <li>
            <img
              src={pt.logo}
              alt={pt.name ? `${pt.name} logo` : "Patron logo"}
              width="150"
              height="107"
              loading="lazy"
              class="h-14 w-auto opacity-80 transition-opacity hover:opacity-100"
            />
            {pt.name && <p class="mt-2 text-[0.82rem] text-muted-foreground">{pt.name}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Closing CTA: the quad stays the primary action, with the championship
      named beside it so the page does not end quads-only. */}
  <section class="board-texture relative isolate overflow-hidden border-t border-border bg-board text-board-foreground">
    <Bolt size={300} class="bolt-mark hidden sm:block" />
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-2">
      <div>
        <p class="bolt-rule label mb-3 max-w-[14rem] text-gold">
          <Bolt size={13} />
          Play with us
        </p>
        <h2 class="text-2xl font-semibold text-white sm:text-3xl">
          Come to a quad. Three rated games, one morning.
        </h2>
        <p class="mt-3 max-w-[48ch] leading-relaxed text-board-foreground/70">
          Every quad date through November is open for entry, and so is the
          {" "}{nextChamp.name} on {nextChamp.display.replace(", 2026", "")}. Join the
          WhatsApp group and you will hear about pairings, results and new
          events first.
        </p>
      </div>
      <div class="flex flex-wrap items-start gap-3 md:justify-end">
        <a
          href={next.register}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 items-center gap-2 rounded-sm bg-gold px-6 font-medium text-gold-foreground transition-colors hover:bg-gold/90"
        >
          <Bolt size={15} />
          Register for the next quad
        </a>
        <a
          href="/championship"
          class="inline-flex h-12 items-center rounded-sm border border-white/25 px-6 font-medium text-white transition-colors hover:border-white/50 hover:bg-white/10"
        >
          Enter the championship
        </a>
        <a
          href={org.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex h-12 items-center rounded-sm border border-white/25 px-6 font-medium text-white transition-colors hover:border-white/50 hover:bg-white/10"
        >
          Join the WhatsApp group
        </a>
      </div>
    </div>
  </section>
</Base>
