---
import Base from "@/layouts/Base.astro";
import { upcomingQuads, pastQuads, testimonials, org } from "@/data/site";

const next = upcomingQuads[0];
const rest = upcomingQuads.slice(1);

const programs = [
  {
    href: "/programs/bay-area",
    tag: "Cupertino",
    title: "Weekly classes and monthly rated quads",
    body:
      "Beginners learn the rules, notation and basic strategy over a ten-week term. Once they are ready, they play a rated quad at the same address.",
    figure: "24",
    figureNote: "rated quads run since 2023",
    photo: "https://i.ibb.co/Fq5BmC0n/bayarea-1s.jpg",
  },
  {
    href: "/programs/national",
    tag: "Alaska, North Dakota, Idaho, Mississippi",
    title: "Free online classes where there is no chess scene",
    body:
      "US Chess has more than 76,000 members. Alaska and North Dakota have fewer than 100 each. We teach an introductory course into those states over video call.",
    figure: "8",
    figureNote: "courses taught since 2024",
    photo: "https://i.ibb.co/d0j36SF9/25206877-7060296.jpg",
  },
  {
    href: "/programs/international",
    tag: "Kenya, Nigeria, Malawi, South Africa",
    title: "Club Bootstrap: helping a school start its first club",
    body:
      "A teacher writes to us. We ship chess sets, run weekly lessons over video, and keep going until the club can run without us. Seven schools so far.",
    figure: "7",
    figureNote: "partner schools, four countries",
    photo: "https://i.ibb.co/BVX6f9ys/2c20fafa-4eec-46bd-9870-b171db690b8f.jpg",
  },
];
---

<Base
  title={org.name}
  description="A youth-led nonprofit running USCF-rated chess tournaments in the Bay Area, free online classes in underserved US states, and school chess clubs in Kenya, Nigeria, Malawi and South Africa."
>
  {/* Hero. Photograph does the emotional work; the text states facts.
      No board texture here — a checkerboard over a photo reads as a
      transparency grid. It is reserved for solid dark panels. */}
  <section class="relative isolate overflow-hidden bg-board">
    <div
      class="absolute inset-0 -z-20 bg-cover bg-[center_30%]"
      style="background-image:url(https://i.ibb.co/qxPc3SG/0d4d204cc1a45454498b448d7adcdcd5.jpg)"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-[linear-gradient(100deg,rgba(8,14,11,.94)_0%,rgba(8,14,11,.72)_58%,rgba(8,14,11,.5)_100%)]"
    >
    </div>

    <div class="mx-auto max-w-6xl px-5 pb-16 pt-20 sm:pb-20 sm:pt-28">
      <p class="label mb-5 text-gold">Cupertino, California &middot; Founded {org.founded}</p>
      <h1
        class="max-w-[19ch] text-[2.6rem] font-semibold leading-[1.04] text-white sm:text-6xl lg:text-[4.2rem]"
      >
        A chess club run by the students it teaches.
      </h1>
      <p class="mt-6 max-w-[54ch] text-[1.06rem] leading-relaxed text-white/72">
        We direct USCF-rated tournaments in the Bay Area, teach free introductory
        courses in four states with almost no chess infrastructure, and help
        schools abroad open their first chess club. Nobody pays to attend
        anything we run.
      </p>

      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="/quads"
          class="inline-flex h-12 items-center rounded-sm bg-gold px-6 font-medium text-gold-foreground transition-colors hover:bg-gold/90"
        >
          Next quad: August 30
        </a>
        <a
          href="/tournaments"
          class="inline-flex h-12 items-center rounded-sm border border-white/25 px-6 font-medium text-white backdrop-blur-sm transition-colors hover:border-white/50 hover:bg-white/10"
        >
          Results archive
        </a>
      </div>
    </div>
  </section>

  {/* Schedule strip, set like a fixtures list rather than a marketing banner. */}
  <section aria-labelledby="sched" class="border-b border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-8">
      <h2 id="sched" class="label mb-5">2026 quad schedule</h2>
      <ol class="grid gap-px overflow-hidden rounded-md bg-border sm:grid-cols-2 lg:grid-cols-4">
        {
          upcomingQuads.map((q, i) => (
            <li class="bg-card p-4">
              <div class="flex items-baseline justify-between gap-3">
                <time datetime={q.date} class="font-mono text-[0.95rem] font-medium">
                  {q.display.replace(", 2026", "")}
                </time>
                {i === 0 && (
                  <span class="rounded-sm bg-primary px-1.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-primary-foreground">
                    Next
                  </span>
                )}
              </div>
              <p class="mt-1 text-[0.82rem] text-muted-foreground">
                {q.venue.name} &middot; {q.format}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Programmes. Asymmetric editorial rows, not a three-card grid. */}
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
    <div class="mb-12 max-w-2xl">
      <p class="label mb-3">What we run</p>
      <h2 class="text-3xl font-semibold sm:text-[2.6rem]">
        Three programmes, built around who is missing from the board.
      </h2>
    </div>

    <div class="divide-y divide-border">
      {
        programs.map((p) => (
          <article class="grid gap-8 py-10 lg:grid-cols-12 lg:gap-12">
            <div class="lg:col-span-4">
              <img
                src={p.photo}
                alt=""
                loading="lazy"
                width="640"
                height="480"
                class="aspect-[4/3] w-full rounded-md border border-border object-cover"
              />
            </div>
            <div class="lg:col-span-6">
              <p class="label mb-2">{p.tag}</p>
              <h3 class="mb-3 text-[1.45rem] font-semibold">{p.title}</h3>
              <p class="max-w-[58ch] leading-relaxed text-muted-foreground">{p.body}</p>
              <a
                href={p.href}
                class="mt-5 inline-flex items-center gap-1.5 text-[0.92rem] font-medium text-primary hover:underline"
              >
                How it works
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
            <div class="lg:col-span-2 lg:border-l lg:border-border lg:pl-6">
              <p class="stat-figure font-heading text-4xl font-semibold text-primary">{p.figure}</p>
              <p class="mt-1 text-[0.82rem] leading-snug text-muted-foreground">{p.figureNote}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* Origin. Text-led, no hero image, breaks the page rhythm on purpose. */}
  <section class="border-y border-border bg-secondary">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-20 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label">Who runs it</p>
      </div>
      <div class="lg:col-span-8">
        <p class="max-w-[46ch] font-heading text-[1.6rem] leading-snug sm:text-[1.9rem]">
          Three Northern California players started this in 2022: WCM Kally Wen,
          Wentao&nbsp;(Sean)&nbsp;Wu and Vincent&nbsp;Qin.
        </p>
        <p class="mt-6 max-w-[62ch] leading-relaxed text-muted-foreground">
          They were high school students at the time, and the club is still run
          by high school students. The tournament directors are students. The
          coaches are students. That is unusual, and it is the reason we can keep
          everything free.
        </p>
        <a
          href="/about"
          class="mt-6 inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent"
        >
          The people involved
        </a>
      </div>
    </div>
  </section>

  {/* Testimonials as a quiet quote list rather than a card carousel. */}
  <section class="mx-auto max-w-6xl px-5 py-20 sm:py-24">
    <p class="label mb-10">What parents and directors say</p>
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        testimonials.map((t) => (
          <figure class="rule-top pt-6">
            <blockquote class="text-[0.98rem] leading-relaxed">{t.text}</blockquote>
            <figcaption class="mt-4 font-mono text-[0.75rem] uppercase tracking-wider text-muted-foreground">
              {t.who}
              {t.role && <span class="text-muted-foreground/60"> &middot; {t.role}</span>}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  {/* One CTA on the whole site, not one per page. */}
  <section class="border-t border-border">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold">Bring chess to your school</h2>
        <p class="mt-3 max-w-[48ch] leading-relaxed text-muted-foreground">
          Every partnership on this site started with one teacher sending an
          email. We provide the coaching and the equipment.
        </p>
      </div>
      <div class="flex flex-wrap items-start gap-3 md:justify-end">
        <a
          href="/contact"
          class="inline-flex h-12 items-center rounded-sm bg-primary px-6 font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Get in touch
        </a>
        <a
          href="/programs/international"
          class="inline-flex h-12 items-center rounded-sm border border-input px-6 font-medium transition-colors hover:bg-accent"
        >
          How Club Bootstrap works
        </a>
      </div>
    </div>
  </section>
</Base>
