---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import QuadActions from "@/components/QuadActions.astro";
import Bolt from "@/components/Bolt.astro";
import ResultsArchive from "@/components/ResultsArchive";
import { august2026QuadCelebration, upcomingQuads, pastQuads, championshipSeries, upcomingChampionships, legacyEvents, org } from "@/data/site";

const next = upcomingQuads[0];
const nextChampionships = upcomingChampionships.filter((e) => new Date(e.date) >= new Date());
---
<Base
  title="Tournaments"
  description="Lightning Square over-the-board USCF-rated quads, seasonal championship dates and registration, free online events and a searchable results archive since 2023."
>
  <PageHeader
    kicker="Schedule and records"
    title="Tournaments"
    lede="Our monthly quads are over-the-board, USCF-rated tournaments. This page also carries the seasonal championships, with registration and live entry lists, and the full results archive."
    crumbs={[{ href: "/", label: "Home" }]}
  />

  {/* Monthly quads: the headline series, not one card among three. */}
  <section class="mx-auto max-w-6xl px-5 py-16">
    <p class="bolt-rule label mb-4 max-w-sm text-primary">
      <Bolt size={13} />
      The main series
    </p>
    <div class="grid gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="mb-3 text-3xl font-semibold sm:text-[2.4rem]">Monthly Quads</h2>
        <p class="mb-4 max-w-[58ch] leading-relaxed text-muted-foreground">
          One Sunday morning a month at the De Anza Learning Center, serving San Francisco and the Bay Area.
          These are over-the-board (OTB) tournaments: four
          players to a section, three games each, G/25&nbsp;d5, dual-rated by US
          Chess. It is the simplest way for a young player to get a real rating
          and the event we build everything else around.
        </p>
        <div class="flex flex-wrap gap-2">
          <a href="/quads" class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">
            Format and full schedule
          </a>
          <a href="/quads/faq" class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">
            Quad FAQ
          </a>
        </div>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-md border border-border bg-card p-5">
          <p class="label mb-2">Next date</p>
          <p class="font-heading text-[1.5rem] font-semibold leading-tight">{next.display}</p>
          <p class="mt-1 text-[0.87rem] text-muted-foreground">
            {next.venue.name} &middot; {next.format}
          </p>
          <QuadActions event={next} size="sm" class="mt-4" />
        </div>
      </div>
    </div>
  </section>

  {/* Every remaining quad date, each with its own two links. */}
  <section class="border-y border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="label mb-6">Upcoming quads</h2>
      <ol class="divide-y divide-border overflow-hidden rounded-md border border-border bg-card">
        {upcomingQuads.map((q, i) => (
          <li class="flex flex-wrap items-center gap-4 p-5">
            <time datetime={q.date} class="w-36 shrink-0 font-mono text-[0.95rem] font-medium">{q.display}</time>
            <div class="min-w-[12rem] flex-1">
              <p class="flex items-center gap-2 font-medium">
                {q.name}
                {i === 0 && (
                  <span class="rounded-sm bg-primary px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-primary-foreground">
                    Next
                  </span>
                )}
              </p>
              <p class="text-[0.85rem] text-muted-foreground">{q.venue.name} &middot; {q.format} &middot; USCF-rated</p>
            </div>
            <QuadActions event={q} size="sm" />
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* Seasonal championships: announced dates first, then the played edition. */}
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="label mb-2">Seasonal championships</h2>
    <p class="mb-6 max-w-[62ch] text-muted-foreground">
      Each championship pairs a rated Swiss main tournament with an evening
      blitz, entered separately. Registration forms open in a new tab; live
      entry lists and full details sit on the championship page.
    </p>

    {nextChampionships.length > 0 && (
      <ol class="mb-10 divide-y divide-border overflow-hidden rounded-md border border-border bg-card">
        {nextChampionships.map((e, i) => (
          <li class="flex flex-wrap items-center gap-4 p-5">
            <time datetime={e.date} class="w-36 shrink-0 font-mono text-[0.95rem] font-medium">{e.display}</time>
            <div class="min-w-[13rem] flex-1">
              <p class="flex items-center gap-2 font-medium">
                {e.name}
                {i === 0 && (
                  <span class="rounded-sm bg-primary px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-primary-foreground">
                    Next
                  </span>
                )}
              </p>
              <p class="text-[0.85rem] text-muted-foreground">Swiss main tournament &middot; evening blitz</p>
            </div>
            <div class="flex flex-wrap gap-2">
              <a href={e.swiss.register} target="_blank" rel="noopener noreferrer"
                 class="inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.85rem] font-medium transition-colors hover:bg-accent">
                Swiss entry
              </a>
              <a href={e.blitz.register} target="_blank" rel="noopener noreferrer"
                 class="inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.85rem] font-medium transition-colors hover:bg-accent">
                Blitz entry
              </a>
              <a href="/championship" class="inline-flex h-10 items-center px-2 text-[0.85rem] font-medium text-primary hover:underline">
                Details
              </a>
            </div>
          </li>
        ))}
      </ol>
    )}

    <h3 class="label mb-2">Past championships</h3>
    <ol class="divide-y divide-border overflow-hidden rounded-md border border-border bg-card">
      {championshipSeries.map((c) => (
        <li class="flex flex-wrap items-center gap-4 p-5">
          <span class="w-36 shrink-0 font-mono text-[0.95rem] font-medium">{c.when}</span>
          <div class="min-w-[14rem] flex-1">
            <p class="font-medium">{c.name}</p>
            <p class="text-[0.85rem] text-muted-foreground">{c.note}</p>
          </div>
          <a href="/championship/past" class="text-[0.88rem] font-medium text-primary hover:underline">Results</a>
        </li>
      ))}
    </ol>
  </section>

  {/* Online, deliberately last: we run these rarely now. */}
  <section class="border-t border-border">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-5 py-10">
      <div>
        <h2 class="text-xl font-semibold">Online tournaments</h2>
        <p class="mt-1 max-w-[58ch] text-[0.92rem] text-muted-foreground">
          Free G/15+10 Swiss events on Chess.com. We run these only occasionally
          now, but the club page stays open and past results are archived.
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/online" class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">Past online events</a>
        <a href={org.chessCom} target="_blank" rel="noopener noreferrer" class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">Our Chess.com club</a>
      </div>
    </div>
  </section>

  {/* One-off events from 2023, kept so the record stays complete. */}
  <section class="border-t border-border">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="label mb-2">Earlier events</h2>
      <p class="mb-6 max-w-[62ch] text-muted-foreground">
        Two one-off tournaments from 2023, before the club settled into the
        monthly quad rhythm. Neither has run since.
      </p>
      <ul class="grid gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-2">
        {legacyEvents.map((e) => (
          <li class="bg-card p-6">
            <p class="label mb-2">{e.date}</p>
            <h3 class="mb-1 text-[1.15rem] font-semibold">{e.name}</h3>
            <p class="mb-4 font-mono text-[0.85rem] text-muted-foreground">{e.format}</p>
            {e.detail.map((d) => (
              <p class="mb-3 text-[0.92rem] leading-relaxed text-muted-foreground">{d}</p>
            ))}
            <p class="mt-4 text-[0.88rem]">
              <span class="font-medium">{e.venue.name}</span><br />
              <span class="text-muted-foreground">{e.venue.address}</span>
            </p>
            {e.results && (
              <a href={e.results} target="_blank" rel="noopener noreferrer"
                 class="mt-4 inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">
                US Chess crosstable
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="label mb-2">Quads archive</h2>
      <p class="mb-6 max-w-[60ch] text-muted-foreground">
        Every rated quad we have directed. Crosstables are hosted by US Chess and open in a new tab.
      </p>

      <article
        id="august-2026-record"
        aria-labelledby="record-heading"
        class="record-celebration board-texture relative mb-10 overflow-hidden rounded-md border border-gold/70 bg-board px-5 py-8 text-board-foreground shadow-[0_18px_60px_rgba(16,40,28,.24)] sm:px-8 sm:py-10"
      >
        <div class="record-rays" aria-hidden="true"></div>
        <svg class="record-burst record-burst-left" viewBox="0 0 120 120" aria-hidden="true">
          <path d="M60 2 67 42 91 9 76 47 113 29 82 54 119 60 82 67 113 91 76 74 91 112 67 79 60 118 53 79 29 112 44 74 7 91 38 67 1 60 38 54 7 29 44 47 29 9 53 42Z" fill="currentColor" />
        </svg>
        <svg class="record-burst record-burst-right" viewBox="0 0 120 120" aria-hidden="true">
          <path d="M60 2 67 42 91 9 76 47 113 29 82 54 119 60 82 67 113 91 76 74 91 112 67 79 60 118 53 79 29 112 44 74 7 91 38 67 1 60 38 54 7 29 44 47 29 9 53 42Z" fill="currentColor" />
        </svg>

        <div class="relative z-10">
          <div class="mb-8 grid items-end gap-6 lg:grid-cols-[1fr_auto]">
            <div>
              <p class="mb-3 font-mono text-[0.72rem] font-semibold uppercase tracking-[0.22em] text-gold">
                New club record · {august2026QuadCelebration.date}
              </p>
              <h3 id="record-heading" class="max-w-[16ch] text-4xl font-semibold leading-[.98] text-white sm:text-6xl">
                52 entries. One unforgettable quad.
              </h3>
              <p class="mt-5 max-w-[62ch] text-[1rem] leading-relaxed text-board-foreground/80">
                Our biggest monthly quad ever filled 11 quads and a Small Swiss. Congratulations to every first-place finisher who made a record-breaking morning even better.
              </p>
            </div>
            <div class="record-number" aria-label="52 registered entries">
              <span class="block font-heading text-[5.5rem] font-semibold leading-[.75] text-gold sm:text-[7.5rem]">52</span>
              <span class="mt-3 block font-mono text-[0.67rem] font-semibold uppercase tracking-[0.2em] text-white">Registered entries</span>
            </div>
          </div>

          <ol class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
            {august2026QuadCelebration.winners.map((winner, i) => (
              <li class="winner-card group flex min-w-0 items-center gap-3 rounded-sm border border-white/15 bg-white/[.075] px-3 py-3 backdrop-blur-sm">
                <span class="grid size-9 shrink-0 place-items-center rounded-full border border-gold/70 bg-gold/15 font-mono text-xs font-semibold text-gold" aria-hidden="true">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <div class="min-w-0 flex-1">
                  <p class="truncate font-semibold text-white">{winner.name}</p>
                  <p class="font-mono text-[0.68rem] uppercase tracking-wider text-board-foreground/65">{winner.section}</p>
                </div>
                <span class="shrink-0 font-mono text-xs text-gold">{winner.score} pts</span>
              </li>
            ))}
          </ol>

          <div class="mt-7 flex flex-wrap items-center justify-between gap-4 border-t border-white/15 pt-6">
            <p class="font-heading text-xl font-semibold text-white">Congratulations, champions.</p>
            <a
              href={august2026QuadCelebration.results}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-center rounded-sm bg-gold px-5 py-2.5 font-medium text-gold-foreground transition-transform duration-200 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold"
            >
              See the official US Chess results
            </a>
          </div>
        </div>
      </article>

      <ResultsArchive client:load events={pastQuads} />
    </div>
  </section>

  <style>
    .record-celebration {
      isolation: isolate;
    }

    .record-rays {
      position: absolute;
      inset: -45%;
      z-index: -1;
      opacity: 0.14;
      background: repeating-conic-gradient(from 8deg, var(--gold) 0deg 7deg, transparent 7deg 18deg);
      animation: record-spin 32s linear infinite;
    }

    .record-burst {
      position: absolute;
      width: 11rem;
      color: var(--gold);
      opacity: 0.11;
      filter: drop-shadow(0 0 22px color-mix(in srgb, var(--gold) 55%, transparent));
      animation: record-pulse 2.4s ease-in-out infinite alternate;
    }

    .record-burst-left { left: -3.5rem; top: -3.5rem; }
    .record-burst-right { bottom: -4rem; right: -3rem; animation-delay: -1.2s; }

    .record-number {
      min-width: 11rem;
      text-align: left;
      text-shadow: 0 0 34px color-mix(in srgb, var(--gold) 35%, transparent);
    }

    .winner-card {
      transition: border-color 180ms ease, background-color 180ms ease, transform 180ms ease;
    }

    .winner-card:hover {
      border-color: color-mix(in srgb, var(--gold) 65%, transparent);
      background: color-mix(in srgb, var(--gold) 11%, transparent);
      transform: translateY(-2px);
    }

    @keyframes record-spin { to { transform: rotate(360deg); } }
    @keyframes record-pulse { to { opacity: 0.2; transform: scale(1.08) rotate(8deg); } }

    @media (prefers-reduced-motion: reduce) {
      .record-rays,
      .record-burst { animation: none; }
      .winner-card { transition: none; }
      .winner-card:hover { transform: none; }
    }
  </style>

  <script>
    import confetti from "canvas-confetti";

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const celebration = document.querySelector("#august-2026-record");
      if (celebration) {
        const observer = new IntersectionObserver((entries, currentObserver) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          currentObserver.disconnect();

          const colors = ["#e8b04b", "#f7d98d", "#ffffff", "#4fb37e", "#1b5138"];
          const launch = (originX, angle) => confetti({
            particleCount: 130,
            angle,
            spread: 88,
            startVelocity: 58,
            gravity: 0.82,
            scalar: 1.18,
            origin: { x: originX, y: 0.7 },
            colors,
          });

          launch(0.04, 58);
          launch(0.96, 122);
          window.setTimeout(() => confetti({
            particleCount: 190,
            spread: 165,
            startVelocity: 50,
            gravity: 0.72,
            scalar: 1.22,
            origin: { x: 0.5, y: 0.42 },
            colors,
          }), 260);
          window.setTimeout(() => {
            launch(0.14, 65);
            launch(0.86, 115);
          }, 560);
        }, { threshold: 0.28 });

        observer.observe(celebration);
      }
    }
  </script>
</Base>
