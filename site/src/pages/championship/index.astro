---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Bolt from "@/components/Bolt.astro";
import { upcomingChampionships, championship } from "@/data/site";

const now = new Date();
const upcoming = upcomingChampionships.filter((e) => new Date(e.date) >= now);
const next = upcoming[0];
---
<Base
  title="Upcoming championships"
  description="Dates, registration forms and live entry lists for the upcoming Lightning Square seasonal championships, from Fall 2026 through Fall 2027."
>
  <PageHeader
    kicker="Registration open"
    title="Upcoming championships"
    lede="Each championship pairs a rated Swiss main tournament with an evening blitz. The two halves are entered separately, so you can play either one or both."
    crumbs={[{ href: "/", label: "Home" }, { href: "/tournaments", label: "Tournaments" }]}
  />

  {next && (
    <section class="mx-auto max-w-6xl px-5 pt-14">
      <p class="bolt-rule label mb-4 max-w-sm text-primary">
        <Bolt size={13} />
        Next championship
      </p>
      <div class="grid gap-8 rounded-md border border-border bg-card p-6 sm:p-8 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-3xl font-semibold sm:text-[2.2rem]">{next.name}</h2>
          <p class="mt-3 font-mono text-lg">{next.display}</p>
          <p class="mt-4 max-w-[46ch] text-[0.95rem] leading-relaxed text-muted-foreground">
            Sections, time controls and the venue are confirmed closer to the
            date. Registering early helps us plan the sections.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
          {[
            { label: "Swiss main tournament", when: "Daytime", links: next.swiss },
            { label: "Evening blitz", when: "Evening", links: next.blitz },
          ].map((part) => (
            <div class="rounded-sm bg-secondary p-5">
              <p class="label mb-1">{part.when}</p>
              <h3 class="mb-4 text-[1.05rem] font-semibold">{part.label}</h3>
              <div class="flex flex-col gap-2">
                <a href={part.links.register} target="_blank" rel="noopener noreferrer"
                   class="inline-flex h-10 items-center justify-center rounded-sm bg-primary px-4 text-[0.88rem] font-medium text-primary-foreground transition-colors hover:bg-primary/90">
                  Register
                </a>
                <a href={part.links.entries} target="_blank" rel="noopener noreferrer"
                   class="inline-flex h-10 items-center justify-center rounded-sm border border-input bg-card px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">
                  Live entry list
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section aria-labelledby="schedule-heading" class="mx-auto max-w-6xl px-5 py-16">
    <h2 id="schedule-heading" class="label mb-2">Full schedule</h2>
    <p class="mb-6 max-w-[62ch] text-muted-foreground">
      Every announced championship date. Registration forms and live entry
      lists open in a new tab.
    </p>

    {upcoming.length > 0 ? (
      <ol class="divide-y divide-border overflow-hidden rounded-md border border-border bg-card">
        {upcoming.map((e, i) => (
          <li class="grid gap-4 p-5 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-4">
              <p class="flex flex-wrap items-center gap-2 font-medium">
                {e.name}
                {i === 0 && (
                  <span class="rounded-sm bg-primary px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-primary-foreground">
                    Next
                  </span>
                )}
              </p>
              <time datetime={e.date} class="mt-1 block font-mono text-[0.88rem] text-muted-foreground">
                {e.display}
              </time>
            </div>
            {[
              { label: "Swiss", links: e.swiss },
              { label: "Blitz", links: e.blitz },
            ].map((part) => (
              <div class="lg:col-span-4">
                <p class="label mb-2">{part.label}</p>
                <div class="flex flex-wrap gap-2">
                  <a href={part.links.register} target="_blank" rel="noopener noreferrer"
                     class="inline-flex h-9 items-center rounded-sm border border-input px-3 text-[0.85rem] font-medium transition-colors hover:bg-accent">
                    Register
                  </a>
                  <a href={part.links.entries} target="_blank" rel="noopener noreferrer"
                     class="inline-flex h-9 items-center rounded-sm border border-input px-3 text-[0.85rem] font-medium transition-colors hover:bg-accent">
                    Live entries
                  </a>
                </div>
              </div>
            ))}
          </li>
        ))}
      </ol>
    ) : (
      <p class="rounded-md border border-border bg-card p-6 text-muted-foreground">
        No championship dates are open for registration right now. Past results
        stay online in the archive.
      </p>
    )}
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-5 py-12">
      <div>
        <h2 class="text-xl font-semibold">Past championships</h2>
        <p class="mt-1 max-w-[58ch] text-[0.92rem] text-muted-foreground">
          Official US Chess results, podiums and prizes from the {championship.date} Summer
          Championship at the {championship.venue.name}.
        </p>
      </div>
      <a href="/championship/past" class="inline-flex h-11 items-center rounded-sm border border-input bg-card px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">
        Results and podiums
      </a>
    </div>
  </section>
</Base>
