---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { bayAreaCurrent as now, bayAreaPast as past, fallClassFlyer } from "@/data/site";

const outline = [
  "Board setup, piece movement and capturing",
  "Special moves: castling, en passant, promotion",
  "The object of the game, check and checkmate patterns",
  "Algebraic notation and recording a game",
  "Basic opening principles and simple strategy",
  "Tactics: forks, pins, skewers and discovered attacks",
  "Problem-solving exercises and practice games",
];
---
<Base
  title="Bay Area Program"
  description="Free in-person chess classes and USCF-rated quads in Cupertino, California. Course outline, current term and every past session since 2023."
>
  <PageHeader
    kicker="Cupertino, California"
    title="Bay Area classes"
    lede="A ten-week introductory course, taught by student coaches, free to families."
    crumbs={[{ href: "/", label: "Home" }, { href: "/programs", label: "Programs" }]}
  />

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="mb-4 text-2xl font-semibold">What the course covers</h2>
        <p class="mb-6 max-w-[58ch] leading-relaxed text-muted-foreground">
          The course assumes no experience. Students learn how the pieces move,
          then how to read and write a game, then how to spot the tactics that
          decide most junior games. Every session ends with a played game.
        </p>
        <ol class="divide-y divide-border overflow-hidden rounded-md border border-border bg-card">
          {outline.map((item, i) => (
            <li class="flex gap-4 p-4">
              <span class="font-mono text-[0.8rem] text-muted-foreground">{String(i + 1).padStart(2, "0")}</span>
              <span class="text-[0.95rem]">{item}</span>
            </li>
          ))}
        </ol>
      </div>

      <aside class="lg:col-span-5">
        <div class="rounded-md border-2 border-primary bg-card p-6">
          <p class="label mb-3 text-primary">Current term</p>
          <p class="mb-1 font-mono text-[1.05rem] font-medium">{now.dates}</p>
          <p class="mb-4 font-mono text-[0.9rem] text-muted-foreground">{now.time}</p>
          <p class="mb-1 text-[0.92rem] font-medium">{now.venue.name}</p>
          <p class="mb-4 text-[0.86rem] text-muted-foreground">{now.venue.address}</p>
          <p class="mb-5 text-[0.86rem] text-muted-foreground">{now.note}</p>
          <a href={now.register} target="_blank" rel="noopener noreferrer"
             class="inline-flex h-11 w-full items-center justify-center rounded-sm bg-primary px-5 font-medium text-primary-foreground transition-colors hover:bg-primary/90">
            Register
          </a>
        </div>
        {/* Gated on `draft` so a sheet with unconfirmed dates on it can be
            reviewed at /flyers/fall-classes without reaching parents here. */}
        {!fallClassFlyer.draft && (
          <a href="/fall-classes-flyer.pdf" target="_blank" rel="noopener noreferrer"
             class="group mt-4 block overflow-hidden rounded-md border border-border bg-card transition-colors hover:border-primary">
            <img src="/fall-classes-flyer.png" alt={`${fallClassFlyer.term} chess classes flyer`}
                 loading="lazy" width="1275" height="1650"
                 class="w-full border-b border-border bg-white object-contain" />
            <span class="flex items-center justify-between gap-3 p-4 text-[0.88rem] font-medium">
              {fallClassFlyer.term} flyer
              <span class="font-mono text-[0.72rem] uppercase tracking-wider text-muted-foreground group-hover:text-primary">PDF</span>
            </span>
          </a>
        )}

        <img src="https://i.ibb.co/V07PSyS0/bayarea-2s.jpg" alt="A Bay Area chess class in progress"
             loading="lazy" width="720" height="540"
             class="mt-4 aspect-[4/3] w-full rounded-md border border-border object-cover" />
      </aside>
    </div>
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="label mb-6">Past terms</h2>
      <div class="overflow-x-auto rounded-md border border-border bg-card">
        <table class="w-full min-w-[40rem] text-left text-[0.92rem]">
          <caption class="sr-only">Past Bay Area chess classes</caption>
          <thead>
            <tr class="border-b border-border bg-secondary">
              <th scope="col" class="label p-4">Dates</th>
              <th scope="col" class="label p-4">Location</th>
              <th scope="col" class="label p-4">Coaches</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            {past.map((c) => (
              <tr>
                <td class="p-4 align-top">
                  <span class="block font-mono text-[0.88rem] font-medium">{c.dates}</span>
                  {c.note && <span class="block text-[0.82rem] text-muted-foreground">{c.note}</span>}
                </td>
                <td class="p-4 align-top">{c.venue.name}</td>
                <td class="p-4 align-top text-muted-foreground">{c.coaches}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
