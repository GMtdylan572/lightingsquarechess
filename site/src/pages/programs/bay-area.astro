---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Bolt from "@/components/Bolt.astro";
import {
  bayAreaCurrent as now,
  bayAreaPast as past,
  fallClassFlyer as flyer,
} from "@/data/site";

/* The outline is also on the flyer. Here it is a light two-column list
   rather than a bordered table — the page was repeating the flyer's whole
   structure, which is what made it feel cluttered. */
const outline = [
  "Board setup, piece movement and capturing",
  "Special moves: castling, en passant, promotion",
  "The object of the game, check and checkmate patterns",
  "Algebraic notation and recording a game",
  "Basic opening principles and simple strategy",
  "Tactics: forks, pins, skewers and discovered attacks",
  "Problem-solving exercises and practice games",
];
---
<Base
  title="Bay Area Program"
  description="In-person chess classes in Cupertino, California. A ten-week introductory course taught by student coaches, $15 per class. Current term, course outline and every past session since 2023."
>
  <PageHeader
    kicker="Cupertino, California"
    title="Bay Area classes"
    lede="A ten-week introductory course, taught by student coaches, $15 per class."
    crumbs={[{ href: "/", label: "Home" }, { href: "/programs", label: "Programs" }]}
  />

  {/* The term and the button, before anything else. Signing up is the only
      thing this page is for; everything below is supporting detail. */}
  <section class="relative overflow-hidden border-b border-border bg-board text-board-foreground">
    <Bolt size={260} class="bolt-mark" />
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-12 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="bolt-rule label mb-3 max-w-[16rem] text-gold">
          <Bolt size={13} />
          Enrolling now
        </p>
        <p class="font-heading text-[2rem] font-semibold leading-[1.05] text-white sm:text-[2.6rem]">
          {now.dates}
        </p>
        <p class="mt-3 font-mono text-[0.95rem] text-board-foreground/75">
          {now.time} &middot; {now.venue.name}
        </p>
        <p class="mt-1 text-[0.88rem] text-board-foreground/55">
          {now.venue.address} &middot; {now.note}
        </p>
      </div>
      <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
        <a href={now.register} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-12 items-center gap-2 rounded-sm bg-gold px-6 font-medium text-gold-foreground transition-transform hover:-translate-y-0.5">
          <Bolt size={15} />
          Register
        </a>
        <a href={flyer.pdf} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-12 items-center rounded-sm border border-white/25 px-5 font-medium text-white transition-colors hover:bg-white/10">
          Flyer (PDF)
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="mb-4 font-heading text-[1.9rem] font-semibold">What the course covers</h2>
        <p class="mb-8 max-w-[58ch] leading-relaxed text-muted-foreground">
          The course assumes no experience. Students learn how the pieces move,
          then how to read and write a game, then how to spot the tactics that
          decide most junior games. Every session ends with a played game.
        </p>
        <ul class="grid gap-x-8 sm:grid-cols-2">
          {outline.map((item) => (
            <li class="flex gap-2.5 border-b border-border/70 py-2.5 text-[0.93rem] leading-snug">
              <Bolt size={12} class="mt-1 shrink-0 text-gold" />
              {item}
            </li>
          ))}
        </ul>

        <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-5">
          {[
            ["Length", "10 weeks"],
            ["Cost", "$15 / class"],
            ["Ages", "6 and up"],
            ["Coaches", "USCF 2000+"],
          ].map(([k, v]) => (
            <div>
              <dt class="label mb-1 text-muted-foreground">{k}</dt>
              <dd class="font-mono text-[1.15rem] font-medium">{v}</dd>
            </div>
          ))}
        </dl>
      </div>

      <aside class="lg:col-span-5">
        <a href={flyer.pdf} target="_blank" rel="noopener noreferrer"
           class="group block overflow-hidden rounded-md border border-border bg-card transition-colors hover:border-gold">
          <img src={flyer.image} alt={`${flyer.term} chess classes flyer`}
               loading="lazy" width="1224" height="1584"
               class="w-full border-b border-border bg-white object-contain" />
          <span class="flex items-center justify-between gap-3 p-4 text-[0.88rem] font-medium">
            {flyer.term} flyer
            <span class="font-mono text-[0.72rem] uppercase tracking-wider text-muted-foreground group-hover:text-gold">PDF</span>
          </span>
        </a>
        <img src="https://i.ibb.co/V07PSyS0/bayarea-2s.jpg" alt="A Bay Area chess class in progress"
             loading="lazy" width="720" height="540"
             class="mt-4 aspect-[4/3] w-full rounded-md border border-border object-cover" />
      </aside>
    </div>
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="label mb-6">Past terms</h2>
      <ol class="divide-y divide-border overflow-hidden rounded-md border border-border bg-card">
        {past.map((c) => (
          <li class="flex flex-wrap items-baseline gap-x-5 gap-y-1 p-4">
            <span class="w-[15rem] shrink-0 font-mono text-[0.9rem] font-medium">{c.dates}</span>
            <span class="min-w-[10rem] flex-1 text-[0.88rem] text-muted-foreground">
              {c.venue.name}{c.note && ` · ${c.note}`}
            </span>
            {c.coaches && <span class="text-[0.85rem] text-muted-foreground">{c.coaches}</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
