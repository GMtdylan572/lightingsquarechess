---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";

const rows = [
  {
    href: "/programs/bay-area",
    label: "Bay Area",
    status: "Running now",
    title: "In-person classes and over-the-board rated quads",
    body: "Fall 2026 classes meet Tuesdays from September 8 to November 17 at De Anza Learning Center. The ten-session course, for players from unrated to USCF 1000, costs $15 per class. Our over-the-board (OTB), USCF-rated quads are held at the same address.",
    photo: "https://i.ibb.co/Fq5BmC0n/bayarea-1s.jpg",
    facts: [["Dates", "Sep 8–Nov 17"], ["Cost", "$15 / class"], ["Venue", "De Anza Learning Center"]],
  },
  {
    href: "/programs/national",
    label: "National",
    status: "Past programme",
    title: "Free online classes in four states",
    body: "US Chess has more than 76,000 members nationally. Alaska and North Dakota have fewer than a hundred each. From 2024 to 2025, we taught free online courses in those states, Idaho and Mississippi.",
    photo: "https://i.ibb.co/d0j36SF9/25206877-7060296.jpg",
    facts: [["Ran", "2024–2025"], ["Courses", "8"], ["States", "AK, ND, ID, MS"]],
  },
  {
    href: "/programs/international",
    label: "International",
    status: "Past programme",
    title: "Club Bootstrap",
    body: "In 2025 we helped eight public schools across Kenya, Nigeria, Malawi and South Africa start chess clubs with donated sets, online lessons and local support. We are not starting new partnerships at the moment, and the record of the work is kept here.",
    photo: "https://i.ibb.co/BVX6f9ys/2c20fafa-4eec-46bd-9870-b171db690b8f.jpg",
    facts: [["Ran", "2025"], ["Public schools", "8"], ["Countries", "KE, NG, MW, ZA"]],
  },
];
---
<Base
  title="Programs"
  description="Lightning Square's current Bay Area classes and over-the-board rated tournaments, plus records of its past National Program and Club Bootstrap work."
>
  <PageHeader
    kicker="What we run"
    title="Programs"
    lede="What we run today is the San Francisco and Bay Area programme: classes and over-the-board rated quads. The National Program and Club Bootstrap are kept here as records of past work."
    crumbs={[{ href: "/", label: "Home" }]}
  />

  <div class="mx-auto max-w-6xl divide-y divide-border px-5">
    {rows.map((r) => (
      <article class="grid gap-8 py-14 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <img src={r.photo} alt="" loading="lazy" width="720" height="540"
               class="aspect-[4/3] w-full rounded-md border border-border object-cover" />
        </div>
        <div class="lg:col-span-7">
          <div class="mb-2 flex flex-wrap items-center gap-3">
            <p class="label">{r.label}</p>
            <span class:list={[
              "rounded-sm px-1.5 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider",
              r.status === "Running now"
                ? "bg-accent text-accent-foreground"
                : "border border-input text-muted-foreground",
            ]}>{r.status}</span>
          </div>
          <h2 class="mb-3 text-[1.6rem] font-semibold">{r.title}</h2>
          <p class="mb-6 max-w-[58ch] leading-relaxed text-muted-foreground">{r.body}</p>
          <dl class="mb-6 grid gap-px overflow-hidden rounded-md border border-border bg-border sm:grid-cols-3">
            {r.facts.map(([k, v]) => (
              <div class="bg-card p-3">
                <dt class="label mb-0.5">{k}</dt>
                <dd class="font-mono text-[0.92rem]">{v}</dd>
              </div>
            ))}
          </dl>
          <a href={r.href} class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">
            Read more
          </a>
        </div>
      </article>
    ))}
  </div>
</Base>
