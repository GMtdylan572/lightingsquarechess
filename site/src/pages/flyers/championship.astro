---
import Flyer from "@/layouts/Flyer.astro";
import { championshipFlyer as f, org } from "@/data/site";
import { qrSvg, shortUrl } from "@/lib/qr";

const qrs = await Promise.all(f.sections.map((s) => qrSvg(s.register)));
---
<Flyer title={f.edition ?? "Chess Championship"} draft={f.draft}>
  {/* ------------------------------------------------------------ header */}
  <header class="hd">
    <div class="hd-mark">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" fill="currentColor"/></svg>
      <p class="hd-org">Lightning Square <span>Chess Club</span></p>
    </div>
    <h1 class="hd-title">Chess Championship</h1>
    <p class="hd-ed mono">{f.edition ?? <span class="tbd">Edition TBD</span>}</p>
  </header>

  {/* ------------------------------------------------------ when / where */}
  <section class="strip">
    <div class="strip-c">
      <p class="label strip-k">Date</p>
      <p class="strip-v mono">{f.date ?? <span class="tbd">TBD</span>}</p>
      <p class="strip-sub mono">
        Main event {f.sections[0].start} &middot; Blitz {f.sections[1].start}
      </p>
    </div>
    <div class="strip-c">
      <p class="label strip-k">Venue</p>
      <p class="strip-v">{f.venue.name}</p>
      <p class="strip-sub">{f.venue.address}</p>
    </div>
    <div class="strip-c">
      <p class="label strip-k">Entry</p>
      <p class="strip-v mono">{f.entryFee ?? <span class="tbd">TBD</span>}</p>
      <p class="strip-sub">US Chess membership required</p>
    </div>
  </section>

  {/* --------------------------------------------------------- sections */}
  <section class="cols">
    {f.sections.map((s, i) => (
      <article class="card">
        <header class="card-hd">
          <h2 class="card-t">{s.name}</h2>
          <span class="card-start mono">{s.start}</span>
        </header>

        <dl class="spec">
          <div><dt class="label">Format</dt><dd>{s.rounds}</dd></div>
          <div><dt class="label">Control</dt><dd class="mono">{s.control}</dd></div>
          <div><dt class="label">Detail</dt><dd>{s.detail}</dd></div>
        </dl>

        {s.schedule.length > 0 && (
          <table class="sched">
            <caption class="label">Round times</caption>
            <tbody>
              {s.schedule.map(([r, t]) => (
                <tr><th scope="row">{r}</th><td class="mono">{t}</td></tr>
              ))}
            </tbody>
          </table>
        )}

        <div class="prizes">
          <p class="label prizes-k">Prizes</p>
          <dl>
            {s.prizes.map(([k, v]) => (
              <div><dt>{k}</dt><dd class="mono">{v}</dd></div>
            ))}
          </dl>
        </div>

        <div class="reg">
          <p class="label reg-k">Scan to register</p>
          {qrs[i] ? (
            <>
              <div class="qr" set:html={qrs[i]} />
              <p class="qr-url mono">{shortUrl(s.register)}</p>
            </>
          ) : (
            <div class="qr-empty"><span class="tbd">TBD</span><p>Form link pending</p></div>
          )}
        </div>
      </article>
    ))}
  </section>

  <p class="note">{f.note}</p>
  <p class="perks">{f.perks}</p>

  {/* ------------------------------------------------------------ footer */}
  <footer class="ft">
    <p class="ft-main">Entries and updates &middot; <span class="mono">{org.email}</span></p>
    <p class="ft-site mono">lightningsquarechess.org</p>
  </footer>
</Flyer>

<style>
  /* ---- header ---- */
  .hd { background: var(--board); color: #fff; padding: 0.42in 0.5in 0.36in; }
  .hd-mark { display: flex; align-items: center; gap: 8px; margin-bottom: 0.22in; }
  .hd-mark svg { width: 20px; height: 20px; color: var(--gold); }
  .hd-org { font-family: "Fraunces Variable", Georgia, serif; font-size: 12pt; font-weight: 600; }
  .hd-org span { color: rgb(255 255 255 / 0.45); font-weight: 400; }
  .hd-title { font-size: 34pt; letter-spacing: -0.015em; }
  .hd-ed { color: var(--gold); font-size: 12pt; font-weight: 500; margin-top: 8px; }

  /* ---- when / where ---- */
  .strip { display: grid; grid-template-columns: 1.1fr 1.3fr 0.75fr; gap: 1px; background: var(--rule); border-bottom: 1px solid var(--rule); }
  .strip-c { background: var(--paper); padding: 0.16in 0.2in; }
  .strip-c:first-child { padding-left: 0.5in; }
  .strip-c:last-child { padding-right: 0.5in; }
  .strip-k { color: var(--muted); margin-bottom: 4px; }
  .strip-v { font-size: 11pt; font-weight: 600; }
  .strip-sub { font-size: 8.5pt; color: var(--muted); margin-top: 3px; line-height: 1.35; }

  /* ---- section cards ---- */
  /* `align-items: start` so the shorter blitz card keeps its natural height.
     Stretching it to match left a blank half-inch that read as a mistake. */
  .cols { flex: 1; display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 0.22in; padding: 0.3in 0.5in 0.16in; }
  .card { border: 1px solid var(--rule); background: var(--card); display: flex; flex-direction: column; }
  .card-hd { display: flex; justify-content: space-between; align-items: baseline; gap: 8px;
             background: var(--board); color: #fff; padding: 0.13in 0.16in; }
  .card-t { font-size: 13.5pt; }
  .card-start { color: var(--gold); font-size: 10.5pt; font-weight: 600; }

  .spec { padding: 0.14in 0.16in 0.1in; display: flex; flex-direction: column; gap: 6px; }
  .spec div { display: flex; gap: 8px; align-items: baseline; }
  .spec dt { color: var(--muted); width: 0.62in; flex: none; }
  .spec dd { font-size: 9pt; line-height: 1.3; }

  .sched { width: calc(100% - 0.32in); margin: 0.02in 0.16in 0.1in; border-collapse: collapse; }
  .sched caption { text-align: left; color: var(--muted); padding-bottom: 5px; }
  .sched th, .sched td { border-top: 1px solid var(--rule); padding: 4.5px 0; font-size: 9pt; }
  .sched th { text-align: left; font-weight: 400; }
  .sched td { text-align: right; font-weight: 600; }

  .prizes { margin: 0.04in 0.16in 0.14in; background: #f1efe7; padding: 0.12in 0.13in; }
  .prizes-k { color: var(--muted); margin-bottom: 6px; }
  .prizes div { display: flex; justify-content: space-between; gap: 10px; font-size: 9pt; padding: 2px 0; }
  .prizes dt { font-weight: 500; }

  .reg { border-top: 1px solid var(--rule); padding: 0.13in 0.16in 0.15in; text-align: center; }
  .reg-k { color: var(--board); }
  .qr { width: 1.15in; height: 1.15in; margin: 7px auto 6px; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
  .qr-url { font-size: 7.5pt; color: var(--muted); word-break: break-all; }
  .qr-empty { padding: 0.16in 0; }
  .qr-empty p { font-size: 8pt; color: var(--muted); margin-top: 6px; }

  /* ---- notes ---- */
  .note { text-align: center; font-size: 7.5pt; color: var(--muted); padding: 0 0.5in 0.12in; }
  .perks { margin: 0 0.5in 0.16in; background: #eef3ee; border: 1px solid #cfe0d3;
           text-align: center; font-size: 9.5pt; font-weight: 500; color: #1b5138; padding: 0.11in; }

  /* ---- footer ---- */
  .ft { display: flex; justify-content: space-between; align-items: center; gap: 0.3in;
        background: var(--board); color: #fff; padding: 0.15in 0.5in; }
  .ft-main { font-size: 9pt; }
  .ft-main .mono { color: var(--gold); }
  .ft-site { font-size: 10pt; font-weight: 600; color: var(--gold); }
</style>
