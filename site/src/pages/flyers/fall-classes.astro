---
import Flyer from "@/layouts/Flyer.astro";
import { fallClassFlyer as f, org, testimonials } from "@/data/site";
import { qrSvg } from "@/lib/qr";

const qr = await qrSvg(f.register);
const short = f.registerShort;
/* A parent's words carry a flyer further than another feature list. */
const quote = testimonials.find((t) => t.who === "Jet Manousos' Mother")!;
---
<Flyer title={`${f.term} ${f.title}`} draft={f.draft}>
  {/* ------------------------------------------------------------ header */}
  <header class="hd">
    <svg class="hd-bolt" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M13.6 1.5 4.2 13.3a.6.6 0 0 0 .47.98h5.06l-1.4 8.06a.6.6 0 0 0 1.06.47l9.44-11.8a.6.6 0 0 0-.47-.98h-5.07l1.4-8.06a.6.6 0 0 0-1.06-.47Z" fill="currentColor"/>
    </svg>

    <div class="hd-mark">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.6 1.5 4.2 13.3a.6.6 0 0 0 .47.98h5.06l-1.4 8.06a.6.6 0 0 0 1.06.47l9.44-11.8a.6.6 0 0 0-.47-.98h-5.07l1.4-8.06a.6.6 0 0 0-1.06-.47Z" fill="currentColor"/></svg>
      <div>
        <p class="hd-org">Lightning Square</p>
        <p class="hd-sub label">Chess Club &middot; Cupertino &middot; Est. {org.founded}</p>
      </div>
    </div>

    <p class="hd-kick label">{f.term} &middot; Ten weeks</p>
    <h1 class="hd-title">Chess<br />Introduction<br />Classes</h1>
    <p class="hd-lede">{f.ages}. No experience needed.</p>
  </header>

  {/* --------------------------------------------------------- key facts */}
  <section class="facts">
    <div class="fact">
      <p class="label fact-k">When</p>
      <p class="fact-v mono">{f.day}</p>
      <p class="fact-v mono">{f.time}</p>
    </div>
    <div class="fact">
      <p class="label fact-k">Dates</p>
      <p class="fact-v mono">{f.dates}</p>
      <p class="fact-note">{f.note}</p>
    </div>
    <div class="fact">
      <p class="label fact-k">Where</p>
      <p class="fact-v">{f.venue.name}</p>
      <p class="fact-note">{f.venue.address}</p>
    </div>
    <div class="fact fact-cost">
      <p class="label fact-k">Cost</p>
      <p class="fact-v-lg">$15</p>
      <p class="fact-note">per class &middot; {f.sessions} classes in the term</p>
    </div>
  </section>

  {/* ------------------------------------------------------------- body */}
  <section class="body">
    <div class="col-main">
      <h2 class="h-sec">Who teaches it</h2>
      <ul class="creds">
        {f.coachCreds.map((c) => (
          <li>
            <svg class="cred-bolt" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.6 1.5 4.2 13.3a.6.6 0 0 0 .47.98h5.06l-1.4 8.06a.6.6 0 0 0 1.06.47l9.44-11.8a.6.6 0 0 0-.47-.98h-5.07l1.4-8.06a.6.6 0 0 0-1.06-.47Z" fill="currentColor"/></svg>
            {c}
          </li>
        ))}
      </ul>

      <h2 class="h-sec mt">What we cover</h2>
      <ol class="outline">
        {f.outline.map((item, i) => (
          <li><span class="mono num">{String(i + 1).padStart(2, "0")}</span>{item}</li>
        ))}
      </ol>

      <blockquote class="quote">
        <p class="quote-text">&ldquo;{quote.text}&rdquo;</p>
        <footer class="quote-by">{quote.who} &middot; {quote.role}</footer>
      </blockquote>
    </div>

    <aside class="col-side">
      <div class="reg">
        <p class="label reg-k">Sign up</p>
        {qr ? (
          <>
            <div class="qr" set:html={qr} />
            <p class="qr-hint">Scan with a phone camera</p>
            <p class="qr-url mono">{short}</p>
          </>
        ) : (
          <div class="qr-empty"><span class="tbd">TBD</span></div>
        )}
      </div>

      <ol class="steps">
        {[
          ["Scan", "Point a phone camera at the code."],
          ["Sign up", "One short form per child."],
          ["Turn up", "Bring a pencil. We supply the boards."],
        ].map(([k, v], i) => (
          <li>
            <span class="step-n mono">{i + 1}</span>
            <div>
              <p class="step-k">{k}</p>
              <p class="step-v">{v}</p>
            </div>
          </li>
        ))}
      </ol>
    </aside>
  </section>

  {/* Cross-promotion: most families who come to a class ask about playing
      a rated game next. Tell them before they have to ask. */}
  <aside class="also">
    <svg class="also-bolt" viewBox="0 0 24 24" aria-hidden="true"><path d="M13.6 1.5 4.2 13.3a.6.6 0 0 0 .47.98h5.06l-1.4 8.06a.6.6 0 0 0 1.06.47l9.44-11.8a.6.6 0 0 0-.47-.98h-5.07l1.4-8.06a.6.6 0 0 0-1.06-.47Z" fill="currentColor"/></svg>
    <p>
      <span class="also-k">Ready to play rated?</span>{" "}
      We also run <strong>monthly USCF-rated quads</strong> at the same venue &mdash;
      three games in an afternoon. <span class="mono">lightningsquarechess.org/quads</span>
    </p>
  </aside>

  {/* ------------------------------------------------------------ footer */}
  <footer class="ft">
    <p class="ft-main">Questions? <span class="mono">{org.email}</span></p>
    <p class="ft-site mono">lightningsquarechess.org</p>
  </footer>
</Flyer>

<style>
  /* ---- header ----
     A gold diagonal cuts the dark panel so the sheet opens on an angle
     rather than another stacked rectangle. */
  .hd {
    position: relative;
    overflow: hidden;
    background: var(--board);
    color: #fff;
    padding: 0.42in 0.55in 0.4in;
  }
  .hd::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -0.34in;
    height: 0.5in;
    background: var(--gold);
    transform: rotate(-1.6deg) scaleX(1.15);
  }
  .hd-bolt {
    position: absolute;
    right: -0.55in; top: 50%;
    translate: 0 -50%;
    width: 3.5in; height: 3.5in;
    color: var(--gold);
    opacity: 0.09;
    rotate: 9deg;
  }
  .hd-mark { display: flex; align-items: center; gap: 9px; margin-bottom: 0.3in; }
  .hd-mark svg { width: 21px; height: 21px; color: var(--gold); }
  .hd-org { font-family: "Fraunces Variable", Georgia, serif; font-size: 13pt; font-weight: 600; line-height: 1; }
  .hd-sub { color: rgb(255 255 255 / 0.5); margin-top: 3px; }
  .hd-kick { color: var(--gold); margin-bottom: 8px; }
  .hd-title { font-size: 40pt; line-height: 0.96; letter-spacing: -0.02em; }
  .hd-lede { font-size: 10.5pt; color: rgb(255 255 255 / 0.72); margin-top: 11px; }

  /* ---- key facts ---- */
  .facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--rule); border-bottom: 1px solid var(--rule); }
  .fact { background: var(--paper); padding: 0.16in 0.16in 0.18in; }
  .fact:first-child { padding-left: 0.55in; }
  .fact:last-child { padding-right: 0.55in; }
  .fact-cost { background: #eef3ee; }
  .fact-k { color: var(--muted); margin-bottom: 5px; }
  .fact-v { font-size: 9.5pt; font-weight: 600; line-height: 1.28; }
  .fact-v-lg { font-family: "Fraunces Variable", Georgia, serif; font-size: 17pt; font-weight: 600; color: var(--board-soft); line-height: 1; }
  .fact-note { font-size: 7.5pt; color: var(--muted); margin-top: 3px; line-height: 1.3; }

  /* ---- body ---- */
  .body { flex: 1; display: grid; grid-template-columns: 1fr 2.35in; gap: 0.34in; padding: 0.3in 0.55in 0.16in; }
  .h-sec { font-size: 14.5pt; margin-bottom: 8px; }
  .h-sec.mt { margin-top: 0.2in; }

  /* Coach credentials: the reason a parent picks this over anything else. */
  .creds { list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: 5px 12px; }
  .creds li { display: flex; gap: 6px; align-items: flex-start; font-size: 9pt; font-weight: 500; line-height: 1.3; }
  .cred-bolt { width: 10px; height: 10px; flex: none; color: var(--gold); margin-top: 2px; }

  .outline { list-style: none; }
  .outline li { display: flex; gap: 10px; font-size: 8.8pt; line-height: 1.3; padding: 4.5px 0; border-bottom: 1px solid var(--rule); }
  .outline li:last-child { border-bottom: 0; }
  .num { color: var(--gold); font-weight: 600; font-size: 8pt; padding-top: 1px; }

  .quote { margin-top: 0.18in; border-left: 3px solid var(--gold); padding: 2px 0 2px 0.14in; }
  .quote-text { font-family: "Fraunces Variable", Georgia, serif; font-size: 9pt; line-height: 1.4; color: #22302a; }
  .quote-by { font-family: "IBM Plex Mono", monospace; font-size: 7pt; color: var(--muted); margin-top: 5px; }

  /* ---- sidebar ---- */
  .col-side { display: flex; flex-direction: column; gap: 0.16in; }
  .reg { border: 2px solid var(--board); background: var(--card); padding: 0.16in 0.14in 0.15in; text-align: center; }
  .reg-k { color: var(--board); }
  .qr { width: 1.55in; height: 1.55in; margin: 9px auto 8px; }
  .qr :global(svg) { width: 100%; height: 100%; display: block; }
  .qr-hint { font-size: 8pt; font-weight: 600; color: var(--ink); }
  .qr-url { font-size: 6.5pt; color: var(--muted); word-break: break-all; margin-top: 4px; line-height: 1.3; }
  .qr-empty { padding: 0.3in 0; }

  .steps { list-style: none; display: flex; flex-direction: column; gap: 9px; }
  .steps li { display: flex; gap: 8px; align-items: flex-start; }
  .step-n { width: 15px; height: 15px; flex: none; border-radius: 50%; background: var(--board); color: var(--gold);
            font-size: 7.5pt; font-weight: 600; display: flex; align-items: center; justify-content: center; margin-top: 1px; }
  .step-k { font-weight: 600; font-size: 9pt; }
  .step-v { font-size: 7.8pt; line-height: 1.3; color: var(--muted); margin-top: 1px; }

  /* ---- cross-promo ---- */
  .also {
    display: flex; align-items: center; gap: 9px;
    margin: 0 0.55in 0.16in;
    background: #eef3ee; border-left: 3px solid var(--gold);
    padding: 0.13in 0.16in;
  }
  .also-bolt { width: 15px; height: 15px; flex: none; color: var(--gold); }
  .also p { font-size: 8.6pt; line-height: 1.4; }
  .also-k { font-weight: 600; color: var(--board-soft); }
  .also .mono { font-size: 8pt; color: var(--muted); }

  /* ---- footer ---- */
  .ft { display: flex; justify-content: space-between; align-items: center; gap: 0.3in;
        background: var(--board); color: #fff; padding: 0.15in 0.55in; }
  .ft-main { font-size: 9pt; }
  .ft-main .mono { color: var(--gold); }
  .ft-site { font-size: 10pt; font-weight: 600; color: var(--gold); }
</style>
