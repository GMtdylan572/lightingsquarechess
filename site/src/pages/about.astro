---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { leadership, founders, advisors, org } from "@/data/site";
import type { Person } from "@/data/site";

const groups: { label: string; note: string; people: Person[] }[] = [
  { label: "Leadership", note: "Runs the club day to day", people: leadership },
  { label: "Co-founders", note: "Started it in 2022", people: founders },
  { label: "Honorary advisors", note: "Adults who help us do this properly", people: advisors },
];
---
<Base
  title="About us"
  description="Lightning Square Chess is a youth-led nonprofit founded in 2022 by three Northern California chess players. Meet the students who direct the tournaments and teach the classes."
>
  <PageHeader
    kicker="About us"
    title="A nonprofit run by high school students"
    lede="Founded in 2022. The tournament directors are students, the coaches are students, and that is the reason everything we run is free."
    crumbs={[{ href: "/", label: "Home" }]}
  />

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4"><p class="label">Why the club exists</p></div>
      <div class="lg:col-span-8">
        <p class="max-w-[46ch] font-heading text-[1.55rem] leading-snug sm:text-[1.8rem]">
          Chess rewards patience and planning. Access to good coaching rewards having money and living in the right place.
        </p>
        <p class="mt-6 max-w-[62ch] leading-relaxed text-muted-foreground">
          {org.mission}
        </p>
        <p class="mt-4 max-w-[62ch] leading-relaxed text-muted-foreground">
          Right now that means two things above all: the monthly USCF-rated quad
          tournaments in Cupertino, and the Bay Area classes that get players
          ready for them. Alongside those we still teach free online courses into
          states with almost no chess infrastructure.
        </p>
        <p class="mt-4 max-w-[62ch] leading-relaxed text-muted-foreground">
          The Club Bootstrap Initiative, which helped seven schools abroad open a
          club of their own, is not taking new schools at the moment. Those
          <a href="/schools" class="text-primary underline underline-offset-2">partner schools</a>
          and what came of the work are documented here.
        </p>
      </div>
    </div>
  </section>

  {groups.map((g) => (
    <section class="border-t border-border">
      <div class="mx-auto max-w-6xl px-5 py-14">
        <div class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 class="label">{g.label}</h2>
          <p class="text-[0.88rem] text-muted-foreground">{g.note}</p>
        </div>
        {/* Portraits are the point of this page, so they are sized to be
            looked at: three across at most, four-by-five like a real photo. */}
        <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {g.people.map((p) => (
            <li>
              <img src={p.photo} alt={`Portrait of ${p.name}`} loading="lazy" width="640" height="800"
                   class="mb-4 aspect-[4/5] w-full rounded-md border border-border object-cover [object-position:50%_22%]" />
              {p.role && <p class="label mb-1.5 text-primary">{p.role}</p>}
              <p class="font-heading text-[1.35rem] font-semibold leading-tight">{p.name}</p>
              {p.org && <p class="mt-1 text-[0.92rem] text-muted-foreground">{p.org}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
