---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { leadership, founders, advisors, org } from "@/data/site";
import type { Person } from "@/data/site";

const groups: { label: string; note: string; people: Person[]; portraits: boolean }[] = [
  { label: "Leadership", note: "Runs the club day to day", people: leadership, portraits: true },
  { label: "Co-founders", note: "Started it in 2022", people: founders, portraits: false },
  { label: "Honorary advisors", note: "Adults who help us do this properly", people: advisors, portraits: true },
];
---
<Base
  title="About us"
  description="Lightning Square Chess is a youth-led nonprofit founded in San Jose in 2022. Meet the students who direct its over-the-board tournaments and teach its classes."
>
  <PageHeader
    kicker="About us"
    title="A nonprofit run by high school students"
    lede="Founded in San Jose in 2022. Student directors run our over-the-board tournaments, and student coaches teach the classes."
    crumbs={[{ href: "/", label: "Home" }]}
  />

  <section class="mx-auto max-w-6xl px-5 pb-16 pt-14">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-4"><p class="label">Why the club exists</p></div>
      <div class="lg:col-span-8">
        <p class="max-w-[46ch] font-heading text-[1.55rem] leading-snug sm:text-[1.8rem]">
          Chess rewards patience and planning. Access to good coaching rewards having money and living in the right place.
        </p>
        <p class="mt-6 max-w-[62ch] leading-relaxed text-muted-foreground">
          {org.mission}
        </p>
        <p class="mt-4 max-w-[62ch] leading-relaxed text-muted-foreground">
          Right now that means two things above all: our monthly over-the-board
          (OTB), USCF-rated quad tournaments serving San Francisco and the Bay Area, and Bay Area
          classes that get players ready for them. From 2024 to 2025, we also
          taught free online courses in Alaska, North Dakota, Idaho and Mississippi.
        </p>
        <p class="mt-4 max-w-[62ch] leading-relaxed text-muted-foreground">
          Club Bootstrap helped eight public schools across four countries start
          chess clubs and is not taking new partners at the moment. Those{" "}
          <a href="/schools" class="text-primary underline underline-offset-2">partner schools</a>{" "}
          and what came of the work are documented here.
        </p>
      </div>
    </div>
  </section>

  {groups.map((g) => (
    <section class="border-t border-border">
      <div class="mx-auto max-w-6xl px-5 py-14">
        <div class="mb-8 flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <h2 class="label">{g.label}</h2>
          <p class="text-[0.88rem] text-muted-foreground">{g.note}</p>
        </div>
        <ul class:list={[
          "grid gap-x-8 gap-y-10 sm:grid-cols-2",
          g.label === "Leadership" ? "lg:grid-cols-5" : "lg:grid-cols-3",
        ]}>
          {g.people.map((p) => (
            <li class:list={[!g.portraits && "rounded-md border border-border bg-card p-5"]}>
              {g.portraits && (
                <img src={p.photo} alt={`Portrait of ${p.name}`} loading="lazy" width="640" height="800"
                     class="mb-4 aspect-[4/5] w-full rounded-md border border-border object-cover [object-position:50%_22%]" />
              )}
              {p.role && <p class="label mb-1.5 text-primary">{p.role}</p>}
              <p class="font-heading text-[1.35rem] font-semibold leading-tight">{p.name}</p>
              {p.org && <p class="mt-1 text-[0.92rem] text-muted-foreground">{p.org}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</Base>
