---
/* Landing page for the "you're registered" link in each Google Form's
   confirmation message. Fireworks on arrival, then the next steps. */
import Base from "@/layouts/Base.astro";
import Bolt from "@/components/Bolt.astro";
import { org, upcomingQuads, upcomingChampionships } from "@/data/site";

const quad = upcomingQuads[0];
const champ = upcomingChampionships.find((e) => new Date(e.date) >= new Date()) ?? upcomingChampionships[0];
---
<Base
  title="You're registered"
  description="Thanks for registering for a Lightning Square Chess Club event."
>
  <section class="mx-auto max-w-3xl px-5 py-20 text-center sm:py-28">
    <p class="bolt-rule label mx-auto mb-5 max-w-xs justify-center text-primary">
      <Bolt size={13} />
      Registration received
    </p>
    <h1 class="text-4xl font-semibold sm:text-6xl">You're in! 🎉</h1>
    <p class="mx-auto mt-5 max-w-[48ch] text-[1.06rem] leading-relaxed text-muted-foreground">
      Thanks for registering. Your name will show on the live entry list
      shortly. Pairings, start times and any changes go out in the WhatsApp
      group first.
    </p>

    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a href={org.whatsapp} target="_blank" rel="noopener noreferrer"
         class="inline-flex h-12 items-center gap-2 rounded-sm bg-primary px-6 font-medium text-primary-foreground transition-colors hover:bg-primary/90">
        <Bolt size={15} />
        Join the WhatsApp group
      </a>
      <button type="button" id="again"
              class="inline-flex h-12 items-center rounded-sm border border-input px-6 font-medium transition-colors hover:bg-accent">
        More fireworks
      </button>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-md border border-border bg-border text-left sm:grid-cols-2">
      {quad && (
        <div class="bg-card p-5">
          <p class="label mb-1">Next quad</p>
          <p class="font-semibold">{quad.display}</p>
          <p class="text-[0.88rem] text-muted-foreground">{quad.venue.name}</p>
          {quad.entries && (
            <a href={quad.entries} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex text-[0.9rem] font-medium text-primary hover:underline">
              Live entries
            </a>
          )}
        </div>
      )}
      {champ && (
        <div class="bg-card p-5">
          <p class="label mb-1">Championship</p>
          <p class="font-semibold">{champ.display}</p>
          <p class="text-[0.88rem] text-muted-foreground">{champ.name}</p>
          <a href="/championship" class="mt-3 inline-flex text-[0.9rem] font-medium text-primary hover:underline">
            Entry lists and details
          </a>
        </div>
      )}
    </div>
  </section>

  <script>
    import { fireworks } from "@/lib/fireworks";
    fireworks();
    document.getElementById("again")?.addEventListener("click", () => fireworks(2000));
  </script>
</Base>
