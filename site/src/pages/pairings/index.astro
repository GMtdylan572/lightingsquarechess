---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { pairingEvents, pairingHref } from "@/data/pairings";
---

<Base title="Pairings" description="Find published pairings for upcoming Lightning Square quads and championships.">
  <PageHeader
    kicker="Tournament day"
    title="Pairings"
    lede="Find your event below. The director posts pairings here after they are final; pages update automatically as rounds are released."
    crumbs={[{ href: "/", label: "Home" }, { href: "/tournaments", label: "Tournaments" }]}
  />

  <section class="mx-auto max-w-6xl px-5 py-12 sm:py-16">
    <div class="mb-7 border-b border-rule pb-5">
      <p class="label text-primary">Upcoming events</p>
      <h2 class="mt-2 text-2xl font-bold sm:text-3xl">Choose a tournament</h2>
    </div>
    <ol class="divide-y divide-border overflow-hidden rounded-sm border border-border bg-card">
      {pairingEvents.map((event) => (
        <li class="flex flex-wrap items-center justify-between gap-4 p-5">
          <div>
            <p class="font-semibold">{event.title}</p>
            <p class="mt-1 text-sm text-muted-foreground">{event.date} · {event.eventType}</p>
          </div>
          <a href={pairingHref(event.slug)} class="inline-flex min-h-11 items-center rounded-sm border border-input px-4 font-semibold text-primary transition-colors hover:bg-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
            View pairings
          </a>
        </li>
      ))}
    </ol>
    <p class="mt-6 text-sm text-muted-foreground">If an event has no published pairings yet, its page will say so. Registration lists are separate from pairings.</p>
  </section>
</Base>
