---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Bolt from "@/components/Bolt.astro";
import { girlsFestival as gf, org } from "@/data/site";

const eventJsonLd = {
  "@context": "https://schema.org",
  "@type": "Event",
  name: `Lightning Square ${gf.name} 2026`,
  startDate: gf.date,
  eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
  eventStatus: "https://schema.org/EventScheduled",
  location: { "@type": "Place", name: "San Jose, California", address: "San Jose, CA" },
  isAccessibleForFree: true,
  organizer: { "@type": "Organization", name: org.name, email: org.email },
  description: "A free five-round Swiss chess tournament for girls in grades K–12, with US Chess-rated and unrated sections.",
};
---
<Base
  title={gf.name}
  description="A free one-day chess tournament for girls in grades K–12 in San Jose on Saturday, December 19, 2026. Five rounds, G/30 d5, with rated U800 and 800+ sections and an unrated First Move section."
>
  <script is:inline set:html={JSON.stringify(eventJsonLd)} type="application/ld+json" />

  <PageHeader
    kicker="Free entry · Girls K–12"
    title={gf.name}
    lede={`${gf.display}, in San Jose. A five-round Swiss with two US Chess-rated sections and an unrated section for first-time players.`}
    crumbs={[{ href: "/", label: "Home" }, { href: "/tournaments", label: "Tournaments" }]}
  />

  {/* Registration first: it is the one thing a visitor needs from this page. */}
  <section class="border-b border-border bg-secondary">
    <div class="mx-auto flex max-w-6xl flex-wrap items-end justify-between gap-6 px-5 py-8">
      <div>
        <p class="bolt-rule label mb-2 max-w-xs text-primary">
          <Bolt size={13} />
          Registration open
        </p>
        <p class="font-heading text-[1.75rem] font-semibold leading-tight sm:text-[2.1rem]">{gf.display}</p>
        <p class="mt-1 text-[0.9rem] text-muted-foreground">
          {gf.venue} Online registration closes {gf.onlineCloses}.
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <a href={gf.register} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-11 items-center gap-1.5 rounded-sm bg-primary px-5 text-[0.92rem] font-medium text-primary-foreground transition-colors hover:bg-primary/90">
          <Bolt size={14} />
          Register
        </a>
        <a href={gf.entries} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">
          Live entries
        </a>
        <a href={gf.flyer} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-11 items-center px-2 text-[0.92rem] font-medium text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline">
          Flyer (PDF)
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="mb-4 text-3xl font-semibold">How the day works</h2>
        <p class="mb-4 max-w-[60ch] leading-relaxed text-muted-foreground">
          Every player plays all five rounds of a Swiss, paired against
          opponents with the same score. A player who cannot make a round can
          take a bye and stay in the tournament.
        </p>
        <p class="max-w-[60ch] leading-relaxed text-muted-foreground">
          Onsite registration opens at {gf.onsite.replace("December 19, ", "")}. Two rounds are
          played in the morning, then lunch, then three in the afternoon.
        </p>

        <dl class="mt-8 grid gap-px overflow-hidden rounded-md border border-border bg-border sm:grid-cols-2">
          <div class="bg-card p-4"><dt class="label mb-1">Entry fee</dt><dd class="font-mono text-[1.05rem]">{gf.fee}</dd></div>
          <div class="bg-card p-4"><dt class="label mb-1">Time control</dt><dd class="font-mono text-[1.05rem]">{gf.control}</dd></div>
          <div class="bg-card p-4"><dt class="label mb-1">Rounds</dt><dd class="font-mono text-[1.05rem]">{gf.rounds}, Swiss</dd></div>
          <div class="bg-card p-4"><dt class="label mb-1">Eligibility</dt><dd class="font-mono text-[1.05rem]">Girls, K–12</dd></div>
        </dl>
      </div>

      <div class="lg:col-span-5">
        <div class="rounded-md border border-border bg-card p-5">
          <p class="label mb-3">Round times</p>
          <ol class="divide-y divide-border">
            {gf.roundTimes.map((t, i) => (
              <>
                {i === 2 && (
                  <li class="flex justify-between py-2.5 text-[0.92rem] text-muted-foreground">
                    <span>Lunch</span><span aria-hidden="true">—</span>
                  </li>
                )}
                <li class="flex justify-between py-2.5 text-[0.92rem]">
                  <span>Round {i + 1}</span>
                  <time class="font-mono">{t}</time>
                </li>
              </>
            ))}
          </ol>
        </div>
        <img src="/championship-2026-prize.jpg" alt="A young prize winner with two Lightning Square student directors"
             loading="lazy" width="1281" height="960"
             class="mt-4 aspect-[4/3] w-full rounded-md border border-border object-cover object-[50%_70%]" />
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <h2 class="label mb-2">Sections and prizes</h2>
      <p class="mb-6 max-w-[62ch] text-muted-foreground">
        Rated sections use current US Chess ratings for sections and pairings,
        dual-rated Regular and Quick. Play-ups are allowed within 200 rating
        points of the next section.
      </p>
      <div class="grid gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-3">
        {gf.sections.map((s) => (
          <article class="flex flex-col bg-card p-6">
            <p class="label mb-2">{s.rated ? "US Chess-rated" : "Unrated"}</p>
            <h3 class="mb-3 text-[1.5rem] font-semibold">{s.name}</h3>
            <p class="mb-5 text-[0.92rem] leading-relaxed text-muted-foreground">{s.body}</p>
            <div class="mt-auto rounded-sm bg-secondary p-4">
              <p class="label mb-1">Prizes</p>
              <p class="text-[0.9rem]">{s.prize}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="label mb-6">Good to know</h2>
    <ul class="divide-y divide-border overflow-hidden rounded-md border border-border bg-card">
      {gf.rules.map((r) => <li class="p-5 text-[0.95rem]">{r}</li>)}
    </ul>
  </section>

  <section class="board-texture relative isolate overflow-hidden border-t border-border bg-board text-board-foreground">
    <Bolt size={300} class="bolt-mark hidden sm:block" />
    <div class="mx-auto grid max-w-6xl gap-8 px-5 py-16 md:grid-cols-2">
      <div>
        <p class="bolt-rule label mb-3 max-w-[14rem] text-gold">
          <Bolt size={13} />
          Questions
        </p>
        <h2 class="text-2xl font-semibold text-white sm:text-3xl">Bring a friend. Entry is free.</h2>
        <p class="mt-3 max-w-[48ch] leading-relaxed text-board-foreground/70">
          Write to {org.email} with any question about sections, byes or the venue.
        </p>
      </div>
      <div class="flex flex-wrap items-start gap-3 md:justify-end">
        <a href={gf.register} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-12 items-center gap-2 rounded-sm bg-gold px-6 font-medium text-gold-foreground transition-colors hover:bg-gold/90">
          <Bolt size={15} />
          Register for the festival
        </a>
        <a href={`mailto:${org.email}`}
           class="inline-flex h-12 items-center rounded-sm border border-white/25 px-6 font-medium text-white transition-colors hover:border-white/50 hover:bg-white/10">
          Email us
        </a>
      </div>
    </div>
  </section>
</Base>
