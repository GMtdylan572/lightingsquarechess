---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { championship as c, championshipSeries, org } from "@/data/site";
const past = new Date(c.iso) < new Date();
---
<Base
  title="Championships"
  description="The four Lightning Square championship weekends: Summer, Fall, Winter and Spring. Each pairs a rated main tournament with an evening blitz."
>
  <PageHeader
    kicker="Four a year"
    title="Championships"
    lede="A rated main tournament in the morning, a blitz in the evening. The Summer edition is documented in full below; the other three run the same format."
    crumbs={[{ href: "/", label: "Home" }, { href: "/tournaments", label: "Tournaments" }]}
  />

  <section class="border-b border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-12">
      <h2 class="label mb-5">The series</h2>
      <ol class="grid gap-px overflow-hidden rounded-md border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
        {championshipSeries.map((s) => (
          <li class="bg-card p-5">
            <div class="mb-2 flex items-baseline justify-between gap-2">
              <span class="font-mono text-[0.9rem] font-medium">{s.when}</span>
              <span class:list={[
                "rounded-sm px-1.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider",
                s.status === "played"
                  ? "bg-gold text-gold-foreground"
                  : "border border-input text-muted-foreground",
              ]}>
                {s.status === "played" ? "Played" : "TBD"}
              </span>
            </div>
            <p class="font-medium leading-snug">{s.name.replace(" and Blitz", "")}</p>
            <p class="mt-1 text-[0.82rem] leading-snug text-muted-foreground">
              + evening blitz
            </p>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-[0.9rem] text-muted-foreground">
        More information on the Fall, Winter and Spring championships is coming.
        It will be posted here and announced in the
        <a href={org.whatsapp} target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">WhatsApp group</a>.
      </p>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-5 pt-14">
    <h2 class="text-2xl font-semibold sm:text-3xl">Summer Championship {new Date(c.iso).getFullYear()}</h2>
    <p class="mt-2 text-muted-foreground">{c.date} at the {c.venue.name}, Sunnyvale.</p>
  </div>

  {past && (
    <div class="mx-auto mt-6 max-w-6xl px-5">
      <div class="flex flex-wrap items-center gap-4 rounded-md border border-border bg-accent px-5 py-4">
        <span class="rounded-sm bg-gold px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wider text-gold-foreground">Concluded</span>
        <p class="text-[0.92rem] text-muted-foreground">
          This one has been played. Entry lists stay online below. The next
          championship is the Fall edition in November 2026.
        </p>
      </div>
    </div>
  )}

  <section class="mx-auto max-w-6xl px-5 py-10">
    <div class="grid gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-2">
      {c.sections.map((s) => (
        <article class="bg-card p-6">
          <p class="label mb-3">{s.name}</p>
          <p class="mb-5 font-mono text-2xl font-medium">{s.start}</p>
          <dl class="mb-5 space-y-2 text-[0.92rem]">
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Rounds</dt><dd>{s.rounds}</dd></div>
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Control</dt><dd class="font-mono">{s.control}</dd></div>
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Detail</dt><dd>{s.detail}</dd></div>
          </dl>
          <div class="rounded-sm bg-secondary p-4">
            <p class="label mb-2">Prizes</p>
            <dl class="space-y-1 text-[0.9rem]">
              {s.prizes.map(([k, v]) => (
                <div class="flex justify-between gap-4"><dt>{k}</dt><dd class="font-mono">{v}</dd></div>
              ))}
            </dl>
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={s.entries} target="_blank" rel="noopener noreferrer"
               class="inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">Entry list</a>
            <a href={c.flyer} target="_blank" rel="noopener noreferrer"
               class="inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">Flyer (PDF)</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-2">
      <div>
        <p class="label mb-3">Venue</p>
        <h2 class="mb-3 text-2xl font-semibold">{c.venue.name}</h2>
        <p class="mb-5 text-muted-foreground">{c.venue.address}</p>
        <p class="mb-5 max-w-[52ch] leading-relaxed text-muted-foreground">
          Free parking on site. The playing hall is on the ground floor and is step-free from the car park.
        </p>
        <a href={`https://maps.google.com/?q=${encodeURIComponent(c.venue.address)}`} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">Open in Maps</a>
      </div>
      <img src="https://i.ibb.co/jDwLLct/Screenshot-2023-11-11-at-9-27-31-PM.jpg" alt="Players at a Lightning Square championship"
           loading="lazy" width="800" height="600" class="aspect-[4/3] w-full rounded-md border border-border object-cover" />
    </div>
  </section>
</Base>
