---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import { championship as c, upcomingChampionships } from "@/data/site";
const past = new Date(c.iso) < new Date();
const nextUp = upcomingChampionships.filter((e) => new Date(e.date) >= new Date());
const podiumFinisherCount = c.results.sections.reduce((total, section) => total + section.podium.length, 0);
const prizePool = c.results.sections.reduce(
  (total, section) => total + section.podium.reduce((sum, player) => sum + ("prize" in player ? Number(player.prize.slice(1)) : 0), 0),
  0,
);
---
<Base
  title="Championships"
  description="Registration and live entry lists for the upcoming Lightning Square seasonal championships, plus full results from the Summer Championship held August 9, 2026 in Sunnyvale."
>
  <PageHeader
    kicker="Seasonal championships"
    title="Championships"
    lede="Each championship pairs a rated Swiss main tournament with an evening blitz. Registration for the upcoming editions is open below; the 2026 results follow."
    crumbs={[{ href: "/", label: "Home" }, { href: "/tournaments", label: "Tournaments" }]}
  />

  {nextUp.length > 0 && (
    <section aria-labelledby="upcoming-heading" class="mx-auto max-w-6xl px-5 pt-14">
      <p class="label mb-3 text-primary">Registration open</p>
      <h2 id="upcoming-heading" class="text-3xl font-semibold sm:text-4xl">Upcoming championships</h2>
      <p class="mt-2 max-w-[62ch] text-muted-foreground">
        Each date runs a Swiss main tournament and a blitz event, entered separately.
        Sections, time controls and the venue are announced closer to each date.
      </p>

      <ol class="mt-8 grid gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-2">
        {nextUp.map((e, i) => (
          <li class="bg-card p-6">
            <div class="mb-4 flex flex-wrap items-center gap-3">
              <time datetime={e.date} class="font-mono text-[0.95rem] font-medium">{e.display}</time>
              {i === 0 && (
                <span class="rounded-sm bg-primary px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-wider text-primary-foreground">
                  Next
                </span>
              )}
            </div>
            <h3 class="mb-5 text-xl font-semibold">{e.name}</h3>

            <div class="space-y-4">
              {[
                { label: "Swiss main tournament", links: e.swiss },
                { label: "Evening blitz", links: e.blitz },
              ].map((part) => (
                <div class="rounded-sm bg-secondary p-4">
                  <p class="label mb-3">{part.label}</p>
                  <div class="flex flex-wrap gap-2">
                    <a href={part.links.register} target="_blank" rel="noopener noreferrer"
                       class="inline-flex h-10 items-center rounded-sm bg-primary px-4 text-[0.88rem] font-medium text-primary-foreground transition-opacity hover:opacity-90">
                      Register
                    </a>
                    <a href={part.links.entries} target="_blank" rel="noopener noreferrer"
                       class="inline-flex h-10 items-center rounded-sm border border-input bg-card px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">
                      Live entry list
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )}

  <div class="mx-auto max-w-6xl px-5 pt-16">
    <h2 class="text-2xl font-semibold sm:text-3xl">Summer Championship {new Date(c.iso).getFullYear()}</h2>
    <p class="mt-2 text-muted-foreground">{c.date} at the {c.venue.name}, Sunnyvale.</p>
  </div>

  {past && (
    <div class="mx-auto mt-6 max-w-6xl px-5">
      <div class="flex flex-wrap items-center gap-4 rounded-md border border-border bg-accent px-5 py-4">
        <span class="rounded-sm bg-gold px-2 py-1 font-mono text-[0.65rem] uppercase tracking-wider text-gold-foreground">Concluded</span>
        <p class="text-[0.92rem] text-muted-foreground">
          This event has been played. Official rated results, entry lists and the flyer remain online below.
        </p>
      </div>
    </div>
  )}

  <section aria-labelledby="results-heading" class="mx-auto max-w-6xl px-5 pb-4 pt-12">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-5">
      <div>
        <p class="label mb-3 text-primary">Official results</p>
        <h2 id="results-heading" class="text-3xl font-semibold sm:text-4xl">Championship podiums</h2>
      </div>
      <div class="max-w-md">
        <p class="font-mono text-sm font-semibold text-foreground">{podiumFinisherCount} podium finishers · ${prizePool} awarded</p>
        <p class="mt-1 text-[0.92rem] text-muted-foreground">
          Final scores from the official US Chess rated event records.
        </p>
      </div>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {c.results.sections.map((section) => (
        <article class:list={[
          "overflow-hidden rounded-md border border-border bg-card shadow-sm",
          section.name === "Community Blitz" && "lg:col-span-2",
        ]}>
          <div class="flex items-center justify-between gap-4 border-b border-border bg-secondary/50 px-5 py-4">
            <div class="flex items-center gap-3">
              <span class="grid size-8 place-items-center rounded-sm bg-primary font-mono text-sm font-semibold text-primary-foreground" aria-hidden="true">
                3
              </span>
              <div>
                <h3 class="text-xl font-semibold">{section.name}</h3>
                <p class="text-xs text-muted-foreground">{section.name === "Community Blitz" ? "Three podium places · first-place prize" : "First, second and third prizes"}</p>
              </div>
            </div>
            <a href={section.event} target="_blank" rel="noopener noreferrer"
               class="text-[0.8rem] font-medium text-primary underline-offset-4 hover:underline">
              US Chess record
            </a>
          </div>
          <ol class:list={[
            "grid items-end gap-3 p-4 sm:p-5",
            "grid-cols-1 sm:grid-cols-3",
          ]}>
            {section.podium.map((player) => (
              <li class:list={[
                "relative flex min-w-0 flex-col overflow-hidden rounded-sm border bg-secondary p-4",
                player.place === 1
                  ? "border-gold bg-gold/10 sm:min-h-48"
                  : player.place === 2
                    ? "border-border sm:min-h-40"
                    : "border-border sm:min-h-32",
              ]}>
                <div class="mb-5 flex items-center justify-between gap-3">
                  <span class:list={[
                    "grid size-11 place-items-center rounded-full border font-mono text-base font-bold",
                    player.place === 1 ? "border-gold bg-gold text-gold-foreground" : "border-border bg-card text-foreground",
                  ]} aria-label={`${player.place === 1 ? "First" : player.place === 2 ? "Second" : "Third"} place`}>
                    {player.place}
                  </span>
                  {"prize" in player && (
                    <span class="rounded-sm border border-border bg-card px-2.5 py-1 font-mono text-sm font-semibold text-primary">
                      {player.prize}
                    </span>
                  )}
                </div>
                <strong class="mt-auto text-balance text-lg leading-tight">{player.name}</strong>
                <span class="mt-2 font-mono text-[0.78rem] text-muted-foreground">
                  {player.score} {player.score === 1 ? "point" : "points"}
                </span>
                <span class:list={[
                  "absolute inset-x-0 bottom-0 h-1",
                  player.place === 1 ? "bg-gold" : player.place === 2 ? "bg-muted-foreground/55" : "bg-primary/55",
                ]} aria-hidden="true"></span>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-10">
    <div class="grid gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-2">
      {c.sections.map((s) => (
        <article class="bg-card p-6">
          <p class="label mb-3">{s.name}</p>
          <p class="mb-5 font-mono text-2xl font-medium">{s.start}</p>
          <dl class="mb-5 space-y-2 text-[0.92rem]">
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Rounds</dt><dd>{s.rounds}</dd></div>
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Control</dt><dd class="font-mono">{s.control}</dd></div>
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Detail</dt><dd>{s.detail}</dd></div>
          </dl>
          <div class="rounded-sm bg-secondary p-4">
            <p class="label mb-2">Prizes</p>
            <dl class="space-y-1 text-[0.9rem]">
              {s.prizes.map(([k, v]) => (
                <div class="flex justify-between gap-4"><dt>{k}</dt><dd class="font-mono">{v}</dd></div>
              ))}
            </dl>
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={s.entries} target="_blank" rel="noopener noreferrer"
               class="inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">Entry list</a>
            <a href={c.flyer} target="_blank" rel="noopener noreferrer"
               class="inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">Flyer (PDF)</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="label mb-3">Venue</p>
        <h2 class="mb-3 text-2xl font-semibold">{c.venue.name}</h2>
        <p class="mb-5 text-muted-foreground">{c.venue.address}</p>
        <a href={`https://maps.google.com/?q=${encodeURIComponent(c.venue.address)}`} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">Open in Maps</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-8">
        <img src="/championship-2026-room.jpg" alt="Players competing across the tournament room at the 2026 Summer Championship"
             loading="lazy" width="1280" height="960"
             class="aspect-[16/9] w-full rounded-md border border-border object-cover sm:col-span-2" />
        <div class="aspect-[4/3] overflow-hidden rounded-md border border-border bg-card">
          <img src="/championship-2026-directors.jpeg" alt="Student tournament directors working together at the 2026 Summer Championship"
               loading="lazy" width="2000" height="1500"
               class="h-full w-full origin-bottom scale-[1.45] object-cover" />
        </div>
        <img src="/championship-2026-action.jpg" alt="Players, families and tournament directors at the 2026 Summer Championship"
             loading="lazy" width="1707" height="1280"
             class="aspect-[4/3] w-full rounded-md border border-border object-cover" />
      </div>
    </div>
  </section>

  <script>
    import confetti from "canvas-confetti";

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window.setTimeout(() => {
        const gold = ["#e8ad3f", "#f6d47a", "#ffffff"];
        const green = ["#155b3f", "#2f8a65", "#ffffff"];

        confetti({ particleCount: 125, angle: 58, spread: 95, startVelocity: 54, gravity: 0.86, scalar: 1.2, origin: { x: 0.06, y: 0.5 }, colors: gold });
        confetti({ particleCount: 125, angle: 122, spread: 95, startVelocity: 54, gravity: 0.86, scalar: 1.2, origin: { x: 0.94, y: 0.5 }, colors: green });

        window.setTimeout(() => {
          confetti({ particleCount: 165, spread: 155, startVelocity: 49, gravity: 0.76, scalar: 1.25, origin: { x: 0.5, y: 0.25 }, colors: [...gold, ...green] });
        }, 240);

        window.setTimeout(() => {
          confetti({ particleCount: 80, angle: 68, spread: 82, startVelocity: 44, gravity: 0.82, scalar: 1.15, origin: { x: 0.18, y: 0.38 }, colors: green });
          confetti({ particleCount: 80, angle: 112, spread: 82, startVelocity: 44, gravity: 0.82, scalar: 1.15, origin: { x: 0.82, y: 0.38 }, colors: gold });
          confetti({ particleCount: 70, spread: 110, startVelocity: 36, gravity: 0.7, scalar: 1.05, origin: { x: 0.5, y: 0.08 }, colors: [...gold, ...green] });
        }, 540);
      }, 300);
    }
  </script>
</Base>
