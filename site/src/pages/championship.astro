---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Podium from "@/components/Podium.astro";
import { championship as c, championshipSeries, championshipResults as r, org } from "@/data/site";
const past = new Date(c.iso) < new Date();
const resultsIn = r.iso === c.iso;
---
<Base
  title="Championships"
  description="Results of the Lightning Square Summer Championship, plus the Fall, Winter and Spring editions. Each pairs a rated main tournament with an evening blitz."
>
  <PageHeader
    kicker="Four a year"
    title="Championships"
    lede="A rated main tournament in the morning, a blitz in the evening. The Summer edition is documented in full below; the other three run the same format."
    crumbs={[{ href: "/", label: "Home" }, { href: "/tournaments", label: "Tournaments" }]}
  />

  {past && resultsIn && (
    <>
      {/* The championship was played eight days ago. Who won is the news on
          this page, so it comes before the schedule of what is next. */}
      <section class="border-b border-border bg-board text-board-foreground">
        <div class="mx-auto max-w-6xl px-5 py-14">
          <p class="label mb-3 text-gold">Final standings &middot; {r.date}</p>
          <h2 class="font-heading text-3xl font-semibold text-white sm:text-4xl">
            Congratulations to our {r.year} champions
          </h2>
          <p class="mt-4 max-w-2xl leading-relaxed text-board-foreground/70">
            {r.players} players across two sections, {r.games} rated games, and a
            prize fund paid out on the day. Thank you to everyone who played,
            directed and drove.
          </p>

          <dl class="mt-9 grid grid-cols-2 gap-px overflow-hidden rounded-md border border-white/10 bg-white/10 sm:grid-cols-4">
            {[
              ["Players", r.players],
              ["Games", r.games],
              ["Rounds", r.rounds],
              ["Control", r.control],
            ].map(([k, v]) => (
              <div class="bg-board px-4 py-4">
                <dt class="label mb-1 text-board-foreground/50">{k}</dt>
                <dd class="font-mono text-xl font-medium text-white">{v}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section class="mx-auto max-w-6xl px-5 py-16">
        {r.sections.map((s) => (
          <Podium name={s.name} players={s.players} games={s.games} podium={s.podium} />
        ))}

        {/* A rating jump is the one number a young player and their parents
            actually feel, so the biggest one gets its own line. */}
        <aside class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 rounded-md border border-border bg-accent p-5">
          <span class="label text-accent-foreground">Biggest rating gain</span>
          <p class="text-[0.98rem]">
            <span class="font-semibold">{r.climber.name}</span>
            <span class="text-muted-foreground"> &middot; {r.climber.section} &middot; </span>
            <span class="font-mono tabular-nums">{r.climber.from} &rarr; {r.climber.to}</span>
            <span class="ml-1.5 font-mono font-semibold text-primary tabular-nums">
              +{r.climber.to - r.climber.from}
            </span>
          </p>
        </aside>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={r.crosstable} target="_blank" rel="noopener noreferrer"
             class="inline-flex h-11 items-center rounded-sm bg-primary px-5 text-[0.92rem] font-medium text-primary-foreground transition-opacity hover:opacity-90">
            Full US Chess crosstable
          </a>
          <a href="/tournaments"
             class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">
            All results
          </a>
        </div>

        <p class="mt-6 max-w-[68ch] text-[0.85rem] leading-relaxed text-muted-foreground">
          Where players finished on the same score, the trophy order came from the
          announced tiebreak. The US Chess crosstable sorts a point group by
          post-event rating, so it will not always match the trophy order &mdash;
          <a href="/quads/faq" class="text-primary underline underline-offset-2">the FAQ explains why</a>.
        </p>
      </section>
    </>
  )}

  {/* --------------------------------------------------------- the series */}
  <section class="border-y border-border bg-secondary">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <h2 class="label mb-5">The series</h2>
      <ol class="grid gap-px overflow-hidden rounded-md border border-border bg-border sm:grid-cols-2 lg:grid-cols-4">
        {championshipSeries.map((s) => (
          <li class="bg-card p-5">
            <div class="mb-2 flex items-baseline justify-between gap-2">
              <span class="font-mono text-[0.9rem] font-medium">{s.when}</span>
              <span class:list={[
                "rounded-sm px-1.5 py-0.5 font-mono text-[0.6rem] uppercase tracking-wider",
                s.status === "played"
                  ? "bg-gold text-gold-foreground"
                  : "border border-input text-muted-foreground",
              ]}>
                {s.status === "played" ? "Played" : "TBD"}
              </span>
            </div>
            <p class="font-medium leading-snug">{s.name.replace(" and Blitz", "")}</p>
            <p class="mt-1 text-[0.82rem] leading-snug text-muted-foreground">+ evening blitz</p>
          </li>
        ))}
      </ol>
      <p class="mt-4 text-[0.9rem] text-muted-foreground">
        More information on the Fall, Winter and Spring championships is coming.
        It will be posted here and announced in the
        <a href={org.whatsapp} target="_blank" rel="noopener noreferrer" class="text-primary underline underline-offset-2">WhatsApp group</a>.
      </p>
    </div>
  </section>

  {/* ------------------------------------------ format, prizes and venue */}
  <section class="mx-auto max-w-6xl px-5 py-16">
    <h2 class="label mb-6">
      {past ? `Summer ${r.year} format and prize fund` : "Format and prize fund"}
    </h2>
    <div class="grid gap-px overflow-hidden rounded-md border border-border bg-border md:grid-cols-2">
      {c.sections.map((s) => (
        <article class="bg-card p-6">
          <p class="label mb-3">{s.name}</p>
          <p class="mb-5 font-mono text-2xl font-medium">{s.start}</p>
          <dl class="mb-5 space-y-2 text-[0.92rem]">
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Rounds</dt><dd>{s.rounds}</dd></div>
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Control</dt><dd class="font-mono">{s.control}</dd></div>
            <div class="flex gap-3"><dt class="w-28 shrink-0 text-muted-foreground">Detail</dt><dd>{s.detail}</dd></div>
          </dl>
          <div class="rounded-sm bg-secondary p-4">
            <p class="label mb-2">Prizes</p>
            <dl class="space-y-1 text-[0.9rem]">
              {s.prizes.map(([k, v]) => (
                <div class="flex justify-between gap-4"><dt>{k}</dt><dd class="font-mono">{v}</dd></div>
              ))}
            </dl>
          </div>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={s.entries} target="_blank" rel="noopener noreferrer"
               class="inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">Entry list</a>
            <a href={c.flyer} target="_blank" rel="noopener noreferrer"
               class="inline-flex h-10 items-center rounded-sm border border-input px-4 text-[0.88rem] font-medium transition-colors hover:bg-accent">Flyer (PDF)</a>
          </div>
        </article>
      ))}
    </div>
    {past && (
      <p class="mt-4 text-[0.85rem] text-muted-foreground">
        The Open section was advertised but did not draw enough entries to run;
        U1600 played as the top section.
      </p>
    )}
  </section>

  <section class="border-t border-border bg-secondary">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-16 lg:grid-cols-2">
      <div>
        <p class="label mb-3">Venue</p>
        <h2 class="mb-3 text-2xl font-semibold">{c.venue.name}</h2>
        <p class="mb-5 text-muted-foreground">{c.venue.address}</p>
        <p class="mb-5 max-w-[52ch] leading-relaxed text-muted-foreground">
          Free parking on site. The playing hall is on the ground floor and is step-free from the car park.
        </p>
        <a href={`https://maps.google.com/?q=${encodeURIComponent(c.venue.address)}`} target="_blank" rel="noopener noreferrer"
           class="inline-flex h-11 items-center rounded-sm border border-input px-5 text-[0.92rem] font-medium transition-colors hover:bg-accent">Open in Maps</a>
      </div>
      <img src="https://i.ibb.co/jDwLLct/Screenshot-2023-11-11-at-9-27-31-PM.jpg" alt="Players at a Lightning Square championship"
           loading="lazy" width="800" height="600" class="aspect-[4/3] w-full rounded-md border border-border object-cover" />
    </div>
  </section>
</Base>
